<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ShawMuOCR</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Version>3.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);src\**;tests\**;scratch\**</DefaultItemExcludes>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <IlcInstructionSet>avx2</IlcInstructionSet>
    <OptimizationPreference>Size</OptimizationPreference>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- 禁用 .NET AOT 优化跳步发布（UseOptimizedPublish），确保执行完整生成链以触发 Avalonia XAML IL 编译与资源编织 -->
    <UseOptimizedPublish>false</UseOptimizedPublish>
    <!-- .NET 11 Runtime Async V2（预览特性）：async Task/ValueTask 的挂起与恢复改由运行时管理，
         编译器不再为它们生成状态机（IL 显著变小、活栈更干净）。
         已知边界：async void 与 async 迭代器（IAsyncEnumerable）不受支持，仍走编译器状态机。
         NativeAOT / ReadyToRun 均已支持；删除此行即整体回退到编译器状态机模型。
         参见 https://learn.microsoft.com/dotnet/core/whats-new/dotnet-11/runtime -->
    <Features>runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Update="Models\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\ShawMuOCR.Core\ShawMuOCR.Core.csproj" />
    <ProjectReference Include="src\ShawMuOCR.Windows\ShawMuOCR.Windows.csproj" />
    <ProjectReference Include="src\MuClip\MuClip.csproj" />
    <ProjectReference Include="src\MuRecorder\MuRecorder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Libs\x64\muclip_core.dll">
      <Link>muclip_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="Libs\x64\murecorder_core.dll">
      <Link>murecorder_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="PdfPig.Rendering.Skia" Version="0.1.17.1-alpha009" />
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="2.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.156.0-preview.1.26512.10" />
    <PackageReference Include="PdfPig" Version="0.1.17-alpha-202610150035-3452b" />
  </ItemGroup>

  <Target Name="CleanupPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_PdbFilesToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PdbFilesToDelete)" />
  </Target>
</Project>
