<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShawMuOCR.Views.LongScreenshotFloatingWindow"
        Title="长截屏控制台"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Border Name="RootBorder"
            Background="#F21E1E22"
            BorderBrush="#4DFFFFFF"
            BorderThickness="1"
            CornerRadius="18"
            BoxShadow="0 6 22 0 #80000000"
            Padding="14,7"
            Margin="8">
        <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
            <!-- 左侧状态/尺寸区（移除了冗余提示） -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="2,0,10,0">
                <TextBlock Text="📜" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Name="StatusTextBlock"
                           Text="0 px"
                           Foreground="#FFFFFF"
                           FontWeight="Medium"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 中间按钮区 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- 自动滚动按钮：点击开始自动平滑滚动并变成【停止】，再次点击停止并完成 -->
                <Button Name="AutoScrollButton"
                        Content="⚡ 自动滚动"
                        Background="#2BFFFFFF"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        CornerRadius="14"
                        Padding="12,4"
                        FontSize="12"
                        ToolTip.Tip="让软件自动平滑向下滚动页面进行长截图" />

                <Button Name="FinishButton"
                        Content="✓ 完成"
                        Background="#0078D4"
                        Foreground="#FFFFFF"
                        FontWeight="SemiBold"
                        CornerRadius="14"
                        Padding="12,4"
                        FontSize="12"
                        ToolTip.Tip="完成长截屏并写入剪贴板 (Enter 或再次按快捷键)" />

                <Button Name="CancelButton"
                        Content="✕ 取消"
                        Background="#2BFFFFFF"
                        Foreground="#CCCCCC"
                        CornerRadius="14"
                        Padding="10,4"
                        FontSize="12"
                        ToolTip.Tip="取消本次长截屏 (Esc)" />
            </StackPanel>

            <!-- 右侧拖拽/提示区 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,2,0">
                <TextBlock Text="⋮⋮" Foreground="#555555" FontSize="12" VerticalAlignment="Center" ToolTip.Tip="按住可拖动位置" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
