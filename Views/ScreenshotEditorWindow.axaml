<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:ShawMuOCR.Views.Components"
        x:Class="ShawMuOCR.Views.ScreenshotEditorWindow"
        Title="截图标注"
        Icon="/Assets/logo.ico"
        Topmost="True"
        ShowInTaskbar="True"
        CanResize="True"
        MinWidth="890"
        MinHeight="480"
        Background="#181818"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        DragDrop.AllowDrop="False">

    <components:ScreenshotEditorControl x:Name="EditorControl" IsEmbedded="False" />
</Window>
