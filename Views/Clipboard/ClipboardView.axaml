<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MuClip.ViewModels"
             xmlns:models="using:MuClip.Models"
             xmlns:components="using:ShawMuOCR.Views.Clipboard.Components"
             x:Class="ShawMuOCR.Views.Clipboard.ClipboardView"
             x:Name="Root"
             DragDrop.AllowDrop="True"
             x:DataType="vm:ClipboardViewModel">

    <UserControl.Styles>
        <Style Selector="Button.iconActionBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.iconActionBtn:pointerover">
            <Setter Property="Background" Value="#18888888" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#25007ACC" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#15007ACC" />
        </Style>
    </UserControl.Styles>

    <!-- 主内容轮播容器 (带淡入淡出动画) -->
    <Carousel SelectedIndex="{Binding CurrentViewIndex}" x:Name="ViewCarousel" Margin="0">
            <Carousel.PageTransition>
                <CrossFade Duration="00:00:00.2" />
            </Carousel.PageTransition>

            <!-- ================================================================= -->
            <!-- Page 0: 剪贴板主内容 (顶部操作栏 + 双栏卡片布局)                     -->
            <!-- ================================================================= -->
            <Grid RowDefinitions="Auto,*">
                <!-- 顶部操作栏 (剪贴板主页面) -->
                <Border Grid.Row="0" Margin="0,0,0,10" Padding="12,8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <!-- 左侧：搜索框与分类过滤 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                     PlaceholderText="🔍 搜索剪贴板历史..."
                                     Width="220"
                                     VerticalAlignment="Center" />

                            <ComboBox ItemsSource="{Binding TypeFilters}"
                                      SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}"
                                      Width="100"
                                      VerticalAlignment="Center" />

                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="260" />
                        </StackPanel>

                        <!-- 右侧：常用语规则模板管理、快捷面板底色调色盘、刷新、清空 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                        <!-- 常用语规则模板管理 -->
                        <Button Padding="8,5"
                                ToolTip.Tip="管理常用语规则模板库 (支持直接新增、预览与删除)">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Width="380" MaxHeight="520">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="10" Margin="4">
                                                <!-- 标题与说明 -->
                                                <StackPanel Spacing="3">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Left" Text="⚡ 常用语规则模板管理" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SavedRuleTemplates.Count, StringFormat='共 {0} 个模板'}"
                                                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="预设的时段规则模板，添加常用语时可直接一键复用："
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- 1. 已有模板列表 -->
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="📋 已保存模板列表" FontWeight="SemiBold" FontSize="11.5" />

                                                        <!-- 暂无模板提示 -->
                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                CornerRadius="4" Padding="12,14"
                                                                IsVisible="{Binding !HasRuleTemplates}">
                                                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                                                <TextBlock Text="暂无规则模板" HorizontalAlignment="Center" FontSize="11.5"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <TextBlock Text="可在下方直接新建模板或在常用语编辑中保存" HorizontalAlignment="Center" FontSize="10.5"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- 模板卡片列表 -->
                                                        <ItemsControl ItemsSource="{Binding SavedRuleTemplates}"
                                                                      IsVisible="{Binding HasRuleTemplates}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:PhraseRuleTemplate">
                                                                    <Border Margin="0,2,0,2" Padding="8,6"
                                                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="5">
                                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                                                <TextBlock Text="{Binding SummaryText}" FontSize="10.5"
                                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                <Button Classes="subtle" Padding="6,3" FontSize="11"
                                                                                        Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).ApplyRuleTemplateCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        ToolTip.Tip="套用到当前规则编辑器">
                                                                                    <TextBlock Text="⚡ 套用" FontSize="11" />
                                                                                </Button>
                                                                                <Button Classes="subtle" Padding="6,3" FontSize="11"
                                                                                        Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).DeleteRuleTemplateCommand}"
                                                                                        CommandParameter="{Binding}"
                                                                                        ToolTip.Tip="删除此模板">
                                                                                    <TextBlock Text="🗑" FontSize="11" Foreground="#EF4444" />
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 2. 新建规则模板 -->
                                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="➕ 新建常用规则模板" FontWeight="SemiBold" FontSize="11.5" />

                                                            <!-- 模板名称 -->
                                                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                                <TextBlock Grid.Column="0" Text="模板名称:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBox Text="{Binding ManagerTemplateName}"
                                                                         PlaceholderText="如：工作日客服后缀、晚间值班..."
                                                                         Height="28" FontSize="11" />
                                                            </Grid>

                                                            <!-- 生效时段与预设 -->
                                                            <StackPanel Spacing="4">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,*" VerticalAlignment="Center">
                                                                    <TextBlock Grid.Column="0" Text="生效时段:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                    <TextBox Grid.Column="1" Text="{Binding ManagerTemplateStartTime}" Height="28" FontSize="11" PlaceholderText="08:00" />
                                                                    <TextBlock Grid.Column="2" Text="~" Margin="6,0" VerticalAlignment="Center" />
                                                                    <TextBox Grid.Column="3" Text="{Binding ManagerTemplateEndTime}" Height="28" FontSize="11" PlaceholderText="18:00" />
                                                                </Grid>
                                                                <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <Button Margin="0,1,3,1" Padding="5,2" FontSize="10" Command="{Binding SetManagerPresetTimeCommand}" CommandParameter="work" Content="工作时段 (09-18)" />
                                                                    <Button Margin="0,1,3,1" Padding="5,2" FontSize="10" Command="{Binding SetManagerPresetTimeCommand}" CommandParameter="morning" Content="上午 (10-12)" />
                                                                    <Button Margin="0,1,3,1" Padding="5,2" FontSize="10" Command="{Binding SetManagerPresetTimeCommand}" CommandParameter="afternoon" Content="下午 (14-18)" />
                                                                    <Button Margin="0,1,3,1" Padding="5,2" FontSize="10" Command="{Binding SetManagerPresetTimeCommand}" CommandParameter="evening" Content="晚上 (18-22)" />
                                                                    <Button Margin="0,1,0,1" Padding="5,2" FontSize="10" Command="{Binding SetManagerPresetTimeCommand}" CommandParameter="all_day" Content="全天" />
                                                                </WrapPanel>
                                                            </StackPanel>

                                                            <!-- 追加位置 -->
                                                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                                <TextBlock Grid.Column="0" Text="追加位置:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                    <Button Padding="8,3" FontSize="11"
                                                                            Command="{Binding SetManagerPresetPositionCommand}" CommandParameter="start"
                                                                            Content="⏪ 文本开头" />
                                                                    <Button Padding="8,3" FontSize="11"
                                                                            Command="{Binding SetManagerPresetPositionCommand}" CommandParameter="end"
                                                                            Content="⏩ 文本末尾" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- 追加内容 -->
                                                            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                                <TextBlock Grid.Column="0" Text="追加内容:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBox Grid.Column="1" Text="{Binding ManagerTemplateAppendText}"
                                                                         PlaceholderText="时段命中的追加文字 (如【客服已受理】)..."
                                                                         Height="28" FontSize="11" />
                                                            </Grid>

                                                            <!-- 保存按钮 -->
                                                            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                    Padding="6,4"
                                                                    Command="{Binding AddTemplateFromManagerCommand}">
                                                                <TextBlock Text="💾 添加到常用规则模板库" FontWeight="SemiBold" FontSize="11.5" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="常用语规则" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 历史清理 (支持按时间区间批量清理) -->
                        <Button Padding="8,5"
                                ToolTip.Tip="按时间区间批量清理剪贴板历史记录">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Width="380" Padding="4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="10" Margin="4">
                                                <!-- 标题与说明 -->
                                                <StackPanel Spacing="3">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Left" Text="🧹 剪贴板历史清理" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalHistoryCount, StringFormat='共 {0} 条记录'}"
                                                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="可根据快捷预设或自定义起止时间，精准批量清理剪贴板历史："
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- 1. 快捷时段预设 -->
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="⚡ 快捷时段预设" FontWeight="SemiBold" FontSize="11.5" />
                                                        <WrapPanel Orientation="Horizontal">
                                                            <Button Margin="0,2,4,2" Padding="6,3" FontSize="11"
                                                                    Command="{Binding SetCleanupPresetCommand}" CommandParameter="1h"
                                                                    Content="近 1 小时前" ToolTip.Tip="清理 1 小时之前的所有历史" />
                                                            <Button Margin="0,2,4,2" Padding="6,3" FontSize="11"
                                                                    Command="{Binding SetCleanupPresetCommand}" CommandParameter="24h"
                                                                    Content="24 小时前" ToolTip.Tip="清理 24 小时之前的所有历史" />
                                                            <Button Margin="0,2,4,2" Padding="6,3" FontSize="11"
                                                                    Command="{Binding SetCleanupPresetCommand}" CommandParameter="3d"
                                                                    Content="3 天前" ToolTip.Tip="清理 3 天之前的所有历史" />
                                                            <Button Margin="0,2,4,2" Padding="6,3" FontSize="11"
                                                                    Command="{Binding SetCleanupPresetCommand}" CommandParameter="7d"
                                                                    Content="7 天前" ToolTip.Tip="清理 7 天之前的所有历史" />
                                                            <Button Margin="0,2,4,2" Padding="6,3" FontSize="11"
                                                                    Command="{Binding SetCleanupPresetCommand}" CommandParameter="30d"
                                                                    Content="30 天前" ToolTip.Tip="清理 30 天之前的所有历史" />
                                                            <Button Margin="0,2,0,2" Padding="6,3" FontSize="11"
                                                                    Command="{Binding SetCleanupPresetCommand}" CommandParameter="today"
                                                                    Content="今天之前" ToolTip.Tip="清理今天 00:00 之前的所有历史" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 2. 自定义时间区间 -->
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="📅 自定义起止时间区间" FontWeight="SemiBold" FontSize="11.5" />

                                                        <!-- 起始时间 -->
                                                        <Grid ColumnDefinitions="60,*" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="起始时间:" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1" Text="{Binding CleanupStartTimeText, Mode=TwoWay}"
                                                                     Height="28" FontSize="11"
                                                                     PlaceholderText="留空表示不限 (如 2026-10-01 00:00:00)" />
                                                        </Grid>

                                                        <!-- 结束时间 -->
                                                        <Grid ColumnDefinitions="60,*" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="结束时间:" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1" Text="{Binding CleanupEndTimeText, Mode=TwoWay}"
                                                                     Height="28" FontSize="11"
                                                                     PlaceholderText="留空表示至现在 (如 2026-10-20 12:00:00)" />
                                                        </Grid>

                                                        <!-- 快捷区间填充按钮 -->
                                                        <WrapPanel Orientation="Horizontal">
                                                            <Button Margin="0,1,4,1" Padding="5,2" FontSize="10.5"
                                                                    Command="{Binding SetCleanupRangeShortcutCommand}" CommandParameter="today_only"
                                                                    Content="仅今日记录" />
                                                            <Button Margin="0,1,4,1" Padding="5,2" FontSize="10.5"
                                                                    Command="{Binding SetCleanupRangeShortcutCommand}" CommandParameter="yesterday_only"
                                                                    Content="仅昨日记录" />
                                                            <Button Margin="0,1,4,1" Padding="5,2" FontSize="10.5"
                                                                    Command="{Binding SetCleanupRangeShortcutCommand}" CommandParameter="this_week"
                                                                    Content="本周内记录" />
                                                            <Button Margin="0,1,0,1" Padding="5,2" FontSize="10.5"
                                                                    Command="{Binding ClearCleanupInputsCommand}"
                                                                    Content="清空条件" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 3. 操作与执行 -->
                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="6"
                                                        Padding="8,6">
                                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding CleanupStatusPrompt}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0" />
                                                        <Button Grid.Column="1"
                                                                Classes="accent"
                                                                Background="#DC2626"
                                                                Foreground="White"
                                                                Padding="12,5"
                                                                CornerRadius="5"
                                                                Command="{Binding ExecuteCleanupByRangeCommand}">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="🗑" FontSize="11" />
                                                                <TextBlock Text="确认清理" FontWeight="SemiBold" FontSize="11.5" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="🧹" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="历史清理" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 快捷面板底色调色盘 -->
                        <Button Padding="8,5"
                                ToolTip.Tip="自定义快捷面板背景底色">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Spacing="10" Width="230" Margin="4">
                                        <TextBlock Text="🎨 快捷面板底色" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="设置 Ctrl+~ 呼出的悬浮快捷面板背景色："
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />

                                        <!-- 预设调色盘色块 -->
                                        <ItemsControl ItemsSource="{Binding PaletteColors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PaletteColorItem">
                                                    <Button Width="26" Height="26" Margin="3" Padding="0" CornerRadius="13"
                                                            BorderBrush="#40808080" BorderThickness="1.5"
                                                            Background="{Binding Brush}"
                                                            Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).SelectPaletteColorCommand}"
                                                            CommandParameter="{Binding Hex}"
                                                            ToolTip.Tip="{Binding Name}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 自定义 Hex 输入 -->
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <TextBox Text="{Binding PanelBackgroundColor, Mode=TwoWay}"
                                                     PlaceholderText="#F4F4F6"
                                                     FontSize="12"
                                                     Padding="6,4" />
                                            <Button Grid.Column="1" Content="应用" Margin="6,0,0,0" Padding="10,4"
                                                    Command="{Binding ApplyPanelBackgroundCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <Border Width="11" Height="11" CornerRadius="5.5"
                                        Background="{Binding CurrentPanelBackgroundBrush}"
                                        BorderBrush="#808080" BorderThickness="1"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="面板底色" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 独立加密数据库备份与还原 (.mubc) -->
                        <Button Padding="8,5"
                                ToolTip.Tip="独立口令加密数据库备份与还原 (.mubc)">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Width="400" MaxHeight="560" Padding="4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="12" Margin="4">
                                                <!-- 标题与说明 -->
                                                <StackPanel Spacing="3">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Left" Text="🔐 独立加密备份与还原" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock DockPanel.Dock="Right" Text=".mubc"
                                                                   FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   FontWeight="Bold" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="采用 XChaCha20-Poly1305 + PBKDF2 高强度单文件加密，全量归档历史记录、常用语与规则："
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- 1. 导出备份卡片 -->
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="📦 导出加密备份文件" FontWeight="SemiBold" FontSize="11.5" />
                                                        
                                                        <Grid ColumnDefinitions="65,*" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="备份密码:" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1" Text="{Binding BackupExportPassword, Mode=TwoWay}"
                                                                     PasswordChar="●" Height="28" FontSize="11"
                                                                     PlaceholderText="设置本次备份的专属保护口令" />
                                                        </Grid>

                                                        <Grid ColumnDefinitions="65,*" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="确认密码:" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1" Text="{Binding BackupExportPasswordConfirm, Mode=TwoWay}"
                                                                     PasswordChar="●" Height="28" FontSize="11"
                                                                     PlaceholderText="再次输入确认密码" />
                                                        </Grid>

                                                        <TextBlock Text="{Binding BackupExportStatus}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding BackupExportStatus.Length}" />

                                                        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                Padding="8,5" Command="{Binding ExportBackupCommand}"
                                                                IsEnabled="{Binding !IsExportingBackup}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="🚀" FontSize="11" />
                                                                <TextBlock Text="选择保存路径并导出备份" FontWeight="SemiBold" FontSize="11" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 2. 导入恢复卡片 -->
                                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="📥 导入并恢复数据" FontWeight="SemiBold" FontSize="11.5" />

                                                        <!-- 选文件行 -->
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                            <TextBox Grid.Column="0" Text="{Binding BackupImportFilePath, Mode=TwoWay}"
                                                                     Height="28" FontSize="11"
                                                                     PlaceholderText="请选择要恢复的 .mubc 文件" />
                                                            <Button Grid.Column="1" Padding="8,4" Command="{Binding PickBackupImportFileCommand}">
                                                                <TextBlock Text="浏览..." FontSize="11" />
                                                            </Button>
                                                        </Grid>

                                                        <!-- 解密密码 -->
                                                        <Grid ColumnDefinitions="65,*" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="解密密码:" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1" Text="{Binding BackupImportPassword, Mode=TwoWay}"
                                                                     PasswordChar="●" Height="28" FontSize="11"
                                                                     PlaceholderText="输入此备份文件的解密密码" />
                                                        </Grid>

                                                        <!-- 恢复模式 -->
                                                        <StackPanel Spacing="4">
                                                            <CheckBox IsChecked="{Binding BackupImportReplaceAll, Mode=TwoWay}"
                                                                      Content="完全覆盖模式 (清空当前库全部数据后还原)"
                                                                      FontSize="11" />
                                                            <TextBlock Text="* 未勾选时默认执行增量合并去重：平滑合并到已有记录，无损迁移。"
                                                                       FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       TextWrapping="Wrap" Margin="20,0,0,0" />
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding BackupImportStatus}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding BackupImportStatus.Length}" />

                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                Padding="8,5" Command="{Binding ImportBackupCommand}"
                                                                IsEnabled="{Binding !IsImportingBackup}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="⚡" FontSize="11" />
                                                                <TextBlock Text="验证密码并开始导入" FontWeight="SemiBold" FontSize="11" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="备份/还原" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RefreshCommand}"
                                Padding="8,5"
                                ToolTip.Tip="从 Rust 内存池热缓存刷新">
                            <TextBlock Text="🔄 刷新" FontSize="12" VerticalAlignment="Center" />
                        </Button>

                        <Button Command="{Binding ClearAllCommand}"
                                Padding="8,5"
                                ToolTip.Tip="清空所有记录">
                            <TextBlock Text="🗑 清空" FontSize="12" Foreground="#EF4444" VerticalAlignment="Center" />
                        </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page 0 双栏卡片布局：列表与详情平分宽度 (*,*) -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*">
                <!-- 左侧：剪贴历史 / 常用语 切换与列表 -->
                <Border Grid.Column="0" Margin="0,0,5,0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Panel x:Name="LeftListPanel">
                        <Grid RowDefinitions="Auto,*">
                            <!-- 顶部双标签切换栏：剪贴历史 | 常用语 -->
                            <Border Grid.Row="0" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <Button Grid.Column="0"
                                            Classes.accent="{Binding IsHistoryTabSelected}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="8,5"
                                            CornerRadius="6"
                                            Command="{Binding SelectHistoryTabCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="📋 剪贴历史" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                            <Border Background="#20888888" CornerRadius="8" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalHistoryCount}" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Classes.accent="{Binding IsPhrasesTabSelected}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="8,5"
                                            CornerRadius="6"
                                            Command="{Binding SelectPhrasesTabCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="💬 常用语" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                            <Border Background="#20888888" CornerRadius="8" Padding="5,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PhrasesCount}" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Tab 0: 剪贴历史列表 -->
                            <ListBox x:Name="HistoryListBox"
                                     Grid.Row="1"
                                     IsVisible="{Binding IsHistoryTabSelected}"
                                     ItemsSource="{Binding FilteredItems}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.IsScrollInertiaEnabled="True"
                                     Background="Transparent"
                                     Padding="4,2"
                                     CornerRadius="6">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:MuClipItem">
                                        <Panel Background="Transparent"
                                               PointerPressed="OnItemPointerPressed">
                                            <!-- 1. 正常状态下的卡片内容：未在拖拽时显示，左右两端留有 8px 边距 -->
                                            <Grid ColumnDefinitions="*,Auto"
                                                  Background="Transparent"
                                                  MinHeight="46"
                                                  Margin="6,0,6,0"
                                                  IsVisible="{Binding !IsDragging}">
                                                <!-- 左侧可点击文本区域 -->
                                                <Grid Grid.Column="0"
                                                      Background="Transparent"
                                                      Cursor="Hand">
                                                    <StackPanel VerticalAlignment="Center" Margin="2,0,4,0">
                                                        <TextBlock Text="{Binding Preview}"
                                                                   FontSize="13.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxLines="2" />
                                                        <!-- 时间与字符统计小字 -->
                                                        <TextBlock Text="{Binding TimeAndCharCount}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Opacity="0.6"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 右侧操作图标按钮（收藏 + 复制 + 删除） -->
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="1"
                                                            VerticalAlignment="Center">
                                                    <!-- 收藏/常用语按钮 -->
                                                    <Button Classes="iconActionBtn"
                                                            Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).ToggleFavoriteCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="加入常用语 / 取消常用语">
                                                        <TextBlock Text="{Binding FavoriteIcon}"
                                                                   Foreground="{Binding FavoriteColor}"
                                                                   Opacity="{Binding FavoriteOpacity}"
                                                                   FontSize="14" />
                                                    </Button>

                                                    <!-- 复制按钮 -->
                                                    <Button Classes="iconActionBtn"
                                                            Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).CopyItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="复制到剪贴板">
                                                        <Panel>
                                                            <TextBlock Text="📋" FontSize="12" Opacity="0.75" IsVisible="{Binding !IsCopied}" />
                                                            <TextBlock Text="✓" FontSize="12" Foreground="#10B981" FontWeight="Bold" IsVisible="{Binding IsCopied}" />
                                                        </Panel>
                                                    </Button>

                                                    <!-- 删除按钮 -->
                                                    <Button Classes="iconActionBtn"
                                                            Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).DeleteItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="删除记录">
                                                        <TextBlock Text="🗑" FontSize="12" Opacity="0.65" Foreground="#EF4444" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 2. 拖拽中的占位边框槽位：仅显示虚线边框与半透明背景，指示队列插槽位置 -->
                                            <Panel IsVisible="{Binding IsDragging}"
                                                   MinHeight="46"
                                                   Margin="6,1">
                                                <Rectangle Fill="#0A007ACC"
                                                           Stroke="#80007ACC"
                                                           StrokeThickness="1.5"
                                                           StrokeDashArray="3,3"
                                                           RadiusX="6"
                                                           RadiusY="6" />
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="6"
                                                            Opacity="0.75">
                                                    <TextBlock Text="⇣"
                                                               FontSize="13"
                                                               Foreground="#007ACC"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="松开放置在此处"
                                                               FontSize="11.5"
                                                               Foreground="#007ACC"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Panel>
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Tab 1: 常用语列表 -->
                            <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsPhrasesTabSelected}">
                                <Border Grid.Row="0" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="8,5"
                                            CornerRadius="6"
                                            Command="{Binding StartNewPhraseCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="➕" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="新增常用语" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Border>

                                <ListBox x:Name="PhrasesListBox"
                                         Grid.Row="1"
                                         ItemsSource="{Binding FilteredPhrases}"
                                         SelectedItem="{Binding SelectedPhrase, Mode=TwoWay}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.IsScrollInertiaEnabled="True"
                                         Background="Transparent"
                                         Padding="4,2"
                                         CornerRadius="6">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:MuClipPhraseItem">
                                            <Panel Background="Transparent"
                                                   PointerPressed="OnItemPointerPressed">
                                                <!-- 1. 正常状态下的卡片内容：未在拖拽时显示，左右两端留有 8px 边距 -->
                                                <Grid ColumnDefinitions="*,Auto"
                                                      Background="Transparent"
                                                      MinHeight="46"
                                                      Margin="6,0,6,0"
                                                      IsVisible="{Binding !IsDragging}">
                                                    <!-- 左侧可点击文本区域 -->
                                                    <Grid Grid.Column="0"
                                                          Background="Transparent"
                                                          Cursor="Hand">
                                                        <StackPanel VerticalAlignment="Center" Margin="2,0,4,0">
                                                            <TextBlock Text="{Binding Preview}"
                                                                       FontSize="13.5"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxLines="2" />
                                                            <!-- 时间与字符统计小字 -->
                                                            <TextBlock Text="{Binding TimeAndCharCount}"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Opacity="0.6"
                                                                       Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- 右侧操作图标按钮（编辑 + 复制 + 删除） -->
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="1"
                                                                VerticalAlignment="Center">
                                                        <!-- 编辑按钮：斜角笔图标 ✎ -->
                                                        <Button Classes="iconActionBtn"
                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).StartEditPhraseCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="在右侧编辑该常用语">
                                                            <TextBlock Text="✎" FontSize="13" Opacity="0.75" />
                                                        </Button>

                                                        <!-- 复制按钮 -->
                                                        <Button Classes="iconActionBtn"
                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).CopyPhraseCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="复制到剪贴板">
                                                            <Panel>
                                                                <TextBlock Text="📋" FontSize="12" Opacity="0.75" IsVisible="{Binding !IsCopied}" />
                                                                <TextBlock Text="✓" FontSize="12" Foreground="#10B981" FontWeight="Bold" IsVisible="{Binding IsCopied}" />
                                                            </Panel>
                                                        </Button>

                                                        <!-- 删除按钮 -->
                                                        <Button Classes="iconActionBtn"
                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).DeletePhraseCommand}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip.Tip="删除常用语">
                                                            <TextBlock Text="🗑" FontSize="12" Opacity="0.65" Foreground="#EF4444" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 2. 拖拽中的占位边框槽位：仅显示虚线边框与半透明背景，指示队列插槽位置 -->
                                                <Panel IsVisible="{Binding IsDragging}"
                                                       MinHeight="46"
                                                       Margin="6,1">
                                                    <Rectangle Fill="#0A007ACC"
                                                               Stroke="#80007ACC"
                                                               StrokeThickness="1.5"
                                                               StrokeDashArray="3,3"
                                                               RadiusX="6"
                                                               RadiusY="6" />
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Spacing="6"
                                                                Opacity="0.75">
                                                        <TextBlock Text="⇣"
                                                                   FontSize="13"
                                                                   Foreground="#007ACC"
                                                                   FontWeight="Bold" />
                                                        <TextBlock Text="松开放置在此处"
                                                                   FontSize="11.5"
                                                                   Foreground="#007ACC"
                                                                   FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Panel>
                                            </Panel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>

                        <!-- 浮动拖拽预览卡片（置顶跟随鼠标光标） -->
                        <Border x:Name="DragPreviewCard"
                                IsHitTestVisible="False"
                                IsVisible="False"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Margin="16,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="#007ACC"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                BoxShadow="0 4 12 0 #30000000"
                                Padding="12,8">
                            <Border.RenderTransform>
                                <TranslateTransform X="0" Y="0" />
                            </Border.RenderTransform>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DragPreviewText"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2" />
                                    <TextBlock x:Name="DragPreviewSubText"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Opacity="0.6"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#18007ACC"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        VerticalAlignment="Center"
                                        Margin="6,0,0,0">
                                    <TextBlock Text="移动中..."
                                               FontSize="11"
                                               Foreground="#007ACC"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Panel>
                </Border>

                <!-- 中间：当前选中项详情展示与常用语编辑区 (与左侧列表 1:1 平分宽度) -->
                <Border Grid.Column="1" Margin="5,0,0,0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <Panel>
                        <!-- 视图 A：剪贴历史详情 -->
                        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsHistoryTabSelected}">
                            <!-- 详情头部元数据 -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="内容详情" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2"
                                            IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Text="{Binding SelectedItem.ContentTypeBadge}" FontSize="11"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedItem.CharCount, StringFormat='{}{0} 字符'}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                               IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBlock Text="{Binding SelectedItem.LineCount, StringFormat='{}{0} 行'}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                               IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                            IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Button Classes="accent" Padding="8,4"
                                            Command="{Binding CopyItemCommand}"
                                            CommandParameter="{Binding SelectedItem}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="📋" FontSize="11" />
                                            <TextBlock Text="复制" FontWeight="SemiBold" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <Button Padding="8,4"
                                            Command="{Binding ToggleFavoriteCommand}"
                                            CommandParameter="{Binding SelectedItem}"
                                            ToolTip.Tip="收藏为常用语或从常用语中移除">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding SelectedItem.FavoriteIcon}"
                                                       Foreground="{Binding SelectedItem.FavoriteColor}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="常用语" FontSize="11.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Padding="8,4"
                                            Command="{Binding BroadcastItemCommand}"
                                            CommandParameter="{Binding SelectedItem}"
                                            ToolTip.Tip="广播到其他局域网设备">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="📡" FontSize="11" />
                                            <TextBlock Text="同步" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <Button Padding="7,4"
                                            Command="{Binding DeleteItemCommand}"
                                            CommandParameter="{Binding SelectedItem}"
                                            ToolTip.Tip="删除本条记录">
                                        <TextBlock Text="🗑" FontSize="11" Foreground="#EF4444" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- 中间文本展示区域 -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8">
                                <Panel>
                                    <TextBox Text="{Binding SelectedItem.Content, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontFamily="Consolas, Cascadia Code, Microsoft YaHei, monospace"
                                             FontSize="13"
                                             IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                    <TextBlock Text="请在左侧选择一条剪贴记录进行查看"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Panel>
                            </Border>

                            <!-- 底部提示信息 -->
                            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="{Binding SyncStatusText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>

                        <!-- 视图 B：常用语详情与编辑 -->
                        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsPhrasesTabSelected}">
                            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PhraseDetailTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PhraseEditorText.Length, StringFormat='{}{0} 字符'}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Button Padding="8,4"
                                            Command="{Binding StartNewPhraseCommand}"
                                            ToolTip.Tip="新建一条常用语">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="➕" FontSize="11" />
                                            <TextBlock Text="新建" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="accent" Padding="8,4"
                                            Command="{Binding SavePhraseCommand}"
                                            ToolTip.Tip="保存当前常用语内容">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="💾" FontSize="11" />
                                            <TextBlock Text="保存" FontWeight="SemiBold" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <Button Padding="8,4"
                                            Command="{Binding CopyPhraseCommand}"
                                            CommandParameter="{Binding SelectedPhrase}"
                                            IsVisible="{Binding HasSelectedPhrase}"
                                            ToolTip.Tip="复制当前常用语到系统剪贴板">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="📋" FontSize="11" />
                                            <TextBlock Text="复制" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <Button Padding="8,4"
                                            Command="{Binding BroadcastPhraseCommand}"
                                            CommandParameter="{Binding SelectedPhrase}"
                                            IsVisible="{Binding HasSelectedPhrase}"
                                            ToolTip.Tip="同步当前常用语到局域网设备">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="📡" FontSize="11" />
                                            <TextBlock Text="同步" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>

                                    <Button Padding="7,4"
                                            Command="{Binding DeletePhraseCommand}"
                                            CommandParameter="{Binding SelectedPhrase}"
                                            IsVisible="{Binding HasSelectedPhrase}"
                                            ToolTip.Tip="删除当前常用语">
                                        <TextBlock Text="🗑" FontSize="11" Foreground="#EF4444" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- 常用语内容与时段条件追加 (上下各半) -->
                            <Grid Grid.Row="1" RowDefinitions="*,8,*">
                                <!-- 上半部分：常用语原始内容输入框 -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8">
                                    <Grid RowDefinitions="*,Auto">
                                        <TextBox Grid.Row="0"
                                                 Text="{Binding PhraseEditorText, Mode=TwoWay}"
                                                 CaretIndex="{Binding PhraseEditorCaretIndex, Mode=TwoWay}"
                                                 KeyUp="OnPhraseEditorKeyUp"
                                                 PointerReleased="OnPhraseEditorPointerReleased"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 PlaceholderText="在此输入或编辑常用语内容，点击右上角「💾 保存」即可生效..."
                                                 FontFamily="Consolas, Cascadia Code, Microsoft YaHei, monospace"
                                                 FontSize="13" />
                                        <!-- 实时光标位置提示栏 -->
                                        <DockPanel Grid.Row="1" Margin="2,6,2,0" LastChildFill="True">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="📍" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CursorPositionText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right"
                                                    Padding="8,2"
                                                    FontSize="11"
                                                    Command="{Binding UseCurrentCaretPositionCommand}"
                                                    ToolTip.Tip="将当前光标字符位置一键填入下方条件追加位置">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="🎯" FontSize="10" />
                                                    <TextBlock Text="设为追加位置" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                    </Grid>
                                </Border>

                                <!-- 下半部分：条件判断追加文字功能面板 -->
                                <Border Grid.Row="2"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="10">
                                            <!-- 标题栏与功能开关 (Grid 左右自适应分栏，彻底杜绝标题被竖向挤压) -->
                                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="⏰" FontSize="13" VerticalAlignment="Center" />
                                                    <TextBlock Text="按当天时段条件动态追加文字"
                                                               FontWeight="SemiBold"
                                                               FontSize="12.5"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center" />
                                                    <Border Background="#15000000" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CurrentRulesCountText}"
                                                                   FontSize="10.5"
                                                                   TextWrapping="NoWrap"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1"
                                                              HorizontalAlignment="Right"
                                                              IsChecked="{Binding IsPhraseRuleEnabled}"
                                                              OnContent="已开启" OffContent="已关闭" />
                                            </Grid>

                                            <!-- 规则编辑表单（受总开关控制，响应式流式布局，不挤压重叠） -->
                                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="9"
                                                    IsEnabled="{Binding IsPhraseRuleEnabled}">
                                                <StackPanel Spacing="9">
                                                    <!-- 0. 常用规则模板复用栏（支持快速套用、一键另存为自定名称模板） -->
                                                    <Border Background="#0C888888" CornerRadius="4" Padding="6,4">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="📋 常用模板:" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding SavedRuleTemplates}"
                                                                      SelectedItem="{Binding SelectedRuleTemplate}"
                                                                      PlaceholderText="选择常用规则模板快速复用..."
                                                                      Height="28" Padding="8,2" Margin="0,0,6,0">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="11" VerticalAlignment="Center" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button Grid.Column="2" Padding="8,3" FontSize="11" Margin="0,0,4,0"
                                                                    Command="{Binding ApplySelectedTemplateCommand}"
                                                                    IsEnabled="{Binding SelectedRuleTemplate, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                    ToolTip.Tip="将选中的模板内容快速填入下方规则表单">
                                                                <TextBlock Text="⚡ 套用" FontSize="11" />
                                                            </Button>
                                                            <Button Grid.Column="3" Padding="6,3" FontSize="11" Margin="0,0,6,0" Classes="subtle"
                                                                    Command="{Binding DeleteRuleTemplateCommand}"
                                                                    IsEnabled="{Binding SelectedRuleTemplate, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                    ToolTip.Tip="删除当前选中的模板">
                                                                <TextBlock Text="🗑" FontSize="11" Foreground="#EF4444" />
                                                            </Button>
                                                            <Button Grid.Column="4" Padding="8,3" FontSize="11"
                                                                    ToolTip.Tip="将当前填写的规则保存为新模板，下次可直接套用">
                                                                <Button.Flyout>
                                                                    <Flyout Placement="BottomEdgeAlignedRight">
                                                                        <StackPanel Width="220" Spacing="8" Margin="4">
                                                                            <TextBlock Text="⭐ 保存为常用规则模板" FontWeight="SemiBold" FontSize="12" />
                                                                            <TextBlock Text="自定模板名称:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                            <TextBox Text="{Binding NewTemplateCustomName}"
                                                                                     PlaceholderText="如：早间问候、夜间值班..."
                                                                                     Height="28" />
                                                                            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                                                    Padding="6,4"
                                                                                    Command="{Binding SaveCurrentAsTemplateCommand}">
                                                                                <TextBlock Text="💾 确认保存模板" FontWeight="SemiBold" FontSize="11.5" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="⭐" FontSize="11" />
                                                                    <TextBlock Text="存为模板..." FontSize="11" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>

                                                    <!-- 1. 追加位置与模式 (隐藏遮挡输入的上下按钮，间距舒展不挤压) -->
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="追加位置:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,2,10,2">
                                                            <TextBlock Text="第" FontSize="11.5" VerticalAlignment="Center" />
                                                            <NumericUpDown Minimum="0" Maximum="9999" Value="{Binding RuleInsertPosition}"
                                                                           ShowButtonSpinner="False"
                                                                           HorizontalContentAlignment="Center"
                                                                           FormatString="0" Width="60" Height="28" Padding="4,2"
                                                                           ToolTip.Tip="直接输入字符序号，如第0个字符为开头" />
                                                            <TextBlock Text="个字符" FontSize="11.5" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <ComboBox SelectedIndex="{Binding RulePositionMode}" Height="28" Padding="8,2" Margin="0,2,10,2">
                                                            <ComboBoxItem Content="在字符前面插入" />
                                                            <ComboBoxItem Content="在字符后面追加" />
                                                        </ComboBox>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,2">
                                                            <Button Padding="8,3" FontSize="11" Command="{Binding SetPositionToStartCommand}" Content="⏪ 开头 (第0字符)" ToolTip.Tip="快捷设为在文本开头插入" />
                                                            <Button Padding="8,3" FontSize="11" Command="{Binding SetPositionToEndCommand}" Content="⏩ 末尾" ToolTip.Tip="快捷设为在文本最末尾追加" />
                                                        </StackPanel>
                                                    </WrapPanel>

                                                    <!-- 2. 生效时段 (预设时段按钮：06-10早上，10-12上午，12-14中午，14-18下午，18-22晚上，22-06夜间) -->
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="生效时段:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,2,8,2">
                                                            <TextBox Text="{Binding RuleStartTime}" Width="60" Height="28" PlaceholderText="06:00" />
                                                            <TextBlock Text="至" FontSize="11.5" VerticalAlignment="Center" />
                                                            <TextBox Text="{Binding RuleEndTime}" Width="60" Height="28" PlaceholderText="10:00" />
                                                            <TextBlock Text="(HH:mm)" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Margin="0,2,4,2" Padding="6,2" FontSize="10.5" Command="{Binding SetPresetTimeRangeCommand}" CommandParameter="early_morning" Content="早上 (06-10)" />
                                                            <Button Margin="0,2,4,2" Padding="6,2" FontSize="10.5" Command="{Binding SetPresetTimeRangeCommand}" CommandParameter="morning" Content="上午 (10-12)" />
                                                            <Button Margin="0,2,4,2" Padding="6,2" FontSize="10.5" Command="{Binding SetPresetTimeRangeCommand}" CommandParameter="noon" Content="中午 (12-14)" />
                                                            <Button Margin="0,2,4,2" Padding="6,2" FontSize="10.5" Command="{Binding SetPresetTimeRangeCommand}" CommandParameter="afternoon" Content="下午 (14-18)" />
                                                            <Button Margin="0,2,4,2" Padding="6,2" FontSize="10.5" Command="{Binding SetPresetTimeRangeCommand}" CommandParameter="evening" Content="晚上 (18-22)" />
                                                            <Button Margin="0,2,0,2" Padding="6,2" FontSize="10.5" Command="{Binding SetPresetTimeRangeCommand}" CommandParameter="night" Content="夜间 (22-06)" />
                                                        </WrapPanel>
                                                    </WrapPanel>

                                                    <!-- 3. 追加文字内容 -->
                                                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="追加文字:" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBox Grid.Column="1" Text="{Binding RuleAppendText}"
                                                                 Height="28"
                                                                 PlaceholderText="输入满足时段条件时自动追加/插入的文本 (如【上午好】、今日排班等)..." />
                                                    </Grid>

                                                    <!-- 4. 添加/保存规则按钮操作栏 (解决无保存按钮与编辑状态反馈) -->
                                                    <DockPanel LastChildFill="False" Margin="0,2,0,0">
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="✏ 正在编辑已选规则，完成后点击保存"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding IsEditingRule}" />
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                            <Button Padding="8,4" FontSize="11"
                                                                    Command="{Binding CancelEditRuleCommand}"
                                                                    IsVisible="{Binding IsEditingRule}"
                                                                    ToolTip.Tip="取消修改并清空规则输入表单">
                                                                <TextBlock Text="✖ 取消编辑" FontSize="11" />
                                                            </Button>
                                                            <Button Classes="accent" Padding="12,5"
                                                                    Command="{Binding AddOrUpdateRuleCommand}"
                                                                    ToolTip.Tip="添加为新规则或保存当前规则修改">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <TextBlock Text="{Binding RuleSubmitButtonIcon}" FontSize="12" />
                                                                    <TextBlock Text="{Binding RuleSubmitButtonText}" FontWeight="SemiBold" FontSize="11.5" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- 5. 实时生效状态与最终输出预览 -->
                                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,5">
                                                <Grid RowDefinitions="Auto,Auto">
                                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding RuleTimeStatusText}" FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock DockPanel.Dock="Right" Text="规则应用模拟" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DockPanel>
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding RulePreviewOutputText}"
                                                               TextWrapping="Wrap"
                                                               FontFamily="Consolas, Cascadia Code, Microsoft YaHei, monospace"
                                                               FontSize="11.5"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </Grid>
                                            </Border>

                                            <!-- 6. 已配置时段规则列表 (支持多规则配置、独立开关、编辑、删除) -->
                                            <StackPanel Spacing="6">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left" Text="📋 已配置的时段规则列表" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentRulesCountText}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <!-- 无规则占位提示 -->
                                                <Border IsVisible="{Binding !HasRules}"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,10"
                                                        HorizontalAlignment="Stretch">
                                                    <TextBlock Text="暂未配置时段规则，在上方填写时段与追加文字后点击「➕ 添加为时段规则」"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Center" />
                                                </Border>

                                                <!-- 规则列表 ItemsControl -->
                                                <ItemsControl ItemsSource="{Binding CurrentPhraseRules}" IsVisible="{Binding HasRules}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:PhraseConditionalRule">
                                                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="8,6"
                                                                    Margin="0,0,0,5">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                                    <CheckBox Grid.Column="0"
                                                                              IsChecked="{Binding IsEnabled}"
                                                                              Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).ToggleRuleCommand}"
                                                                              CommandParameter="{Binding}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,8,0"
                                                                              ToolTip.Tip="启用或停用此规则" />
                                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <Border Background="#15000000" CornerRadius="3" Padding="5,1">
                                                                                <TextBlock Text="{Binding TimeRangeText}" FontSize="11" FontWeight="SemiBold" />
                                                                            </Border>
                                                                            <Border IsVisible="{Binding IsCurrentlyActive}"
                                                                                    Background="#2510B981" CornerRadius="3" Padding="4,1">
                                                                                <TextBlock Text="🟢 生效中" FontSize="10" Foreground="#10B981" FontWeight="SemiBold" />
                                                                            </Border>
                                                                            <TextBlock Text="{Binding PositionSummaryText}" FontSize="10.5"
                                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding AppendTextDisplay}"
                                                                                   FontSize="11.5"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxLines="1"
                                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                        <Button Classes="subtle" Padding="6,3" FontSize="11"
                                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).SaveRuleAsTemplateCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip.Tip="将此规则另存为常用模板，供其他常用语复用">
                                                                            <TextBlock Text="⭐" FontSize="11" Foreground="#F59E0B" />
                                                                        </Button>
                                                                        <Button Classes="subtle" Padding="6,3" FontSize="11"
                                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).EditRuleCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip.Tip="编辑此时段规则">
                                                                            <TextBlock Text="✏ 编辑" FontSize="11" />
                                                                        </Button>
                                                                        <Button Classes="subtle" Padding="6,3" FontSize="11"
                                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).DeleteRuleCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip.Tip="删除此时段规则">
                                                                            <TextBlock Text="🗑" FontSize="11" Foreground="#EF4444" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="{Binding SyncStatusText}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>
                    </Panel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- Page 1: 文件传输页面主体内容                                         -->
        <!-- ================================================================= -->
        <components:ClipboardFileTransferPanel />

        <!-- ================================================================= -->
        <!-- Page 2: 局域网同步页面主体内容 (独立组件)                             -->
        <!-- ================================================================= -->
        <components:ClipboardLanSyncPanel />
    </Carousel>
</UserControl>
