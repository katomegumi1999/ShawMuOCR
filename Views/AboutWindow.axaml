<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShawMuOCR.ViewModels"
        x:Class="ShawMuOCR.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="关于 - 小沐 OCR"
        Width="520" Height="680"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo.ico">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- 头部软件信息 -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Image Source="/Assets/logo.png" Width="44" Height="44" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="小沐 OCR" FontSize="20" FontWeight="Bold" />
                        <Border Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersion}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       FontWeight="Medium" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="轻量、极速的 Windows 本地离线截屏识别工具"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 中间内容卡片 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- 开源项目与作者信息 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="项目与作者" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="MIT 开源协议" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="85,*,Auto" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                        <!-- GitHub 仓库 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="开源仓库："
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GitHubRepoText}"
                                   FontWeight="Medium" FontSize="13" VerticalAlignment="Center" Margin="0,6,12,6"
                                   MinWidth="0"
                                   ClipToBounds="True"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding GitHubUrl}" />
                        <Button Grid.Row="0" Grid.Column="2"
                                Content="🔗 访问仓库"
                                Command="{Binding OpenGitHubCommand}"
                                Width="96"
                                Padding="0,4"
                                HorizontalContentAlignment="Center"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Margin="0,4"
                                ToolTip.Tip="在默认浏览器中打开 GitHub 仓库" />

                        <!-- 作者信息 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="开发作者："
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AuthorText}"
                                   FontWeight="Medium" FontSize="13" VerticalAlignment="Center" Margin="0,6,12,6"
                                   MinWidth="0"
                                   ClipToBounds="True"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding BilibiliUrl}" />
                        <Button Grid.Row="1" Grid.Column="2"
                                Content="📺 访问 B站"
                                Command="{Binding OpenBilibiliCommand}"
                                Width="96"
                                Padding="0,4"
                                HorizontalContentAlignment="Center"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Margin="0,4"
                                ToolTip.Tip="在默认浏览器中访问作者 B站主页" />
                    </Grid>
                    </StackPanel>
                </Border>

                <!-- 模型信息卡片 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="OCR 模型状态" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="🟢" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ModelStatus}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                            <!-- 模型名称 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="当前模型："
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModelName}"
                                       FontWeight="Medium" FontSize="13" Margin="0,3" />

                            <!-- 模型权重尺寸 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="模型权重大小："
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModelWeightsDescription}"
                                       FontSize="13" Margin="0,3" />

                            <!-- 推理运行时 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="推理引擎："
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EngineDescription}"
                                       FontSize="13" Margin="0,3" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 内存实时检测仪表盘 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="内存实时检测" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LastUpdatedText, StringFormat='采样时间: {0}'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- 核心指标网格 -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                            <!-- 物理工作集 -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="12,10" Margin="0,0,6,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="物理内存占用 (Working Set)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding PhysicalWorkingSetText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding PeakWorkingSetText, StringFormat='历史峰值: {0}'}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- 进程专用内存 -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="12,10" Margin="6,0,0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="专用提交内存 (Private Bytes)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding PrivateMemoryText}" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="软件实际独占分配" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- .NET 托管堆 -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="12,10" Margin="0,0,6,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text=".NET 托管堆 (Managed Heap)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding ManagedMemoryText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="C# 对象与 UI 状态" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- 模型原生与非托管 -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="12,10" Margin="6,0,0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="模型与原生引擎 (Native)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding NativeEngineMemoryText}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="ONNX 张量池 / 渲染图形缓冲" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Win32 GDI 资源 -->
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Win32 GDI 资源句柄" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding GdiHandlesText}" FontSize="13" FontWeight="Medium" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="已杜绝句柄泄漏"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 控制按钮 -->
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding StatusMessage}"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />

                            <Button Grid.Column="1"
                                    Content="🔄 刷新数据"
                                    Command="{Binding RefreshMemoryCommand}"
                                    Margin="0,0,8,0"
                                    Padding="12,5"
                                    FontSize="12" />

                            <Button Grid.Column="2"
                                    Content="🧹 深度释放内存"
                                    Command="{Binding TrimMemoryCommand}"
                                    IsEnabled="{Binding !IsTrimming}"
                                    Classes="accent"
                                    Padding="12,5"
                                    FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部栏 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <TextBlock Grid.Column="0"
                       Text="基于 Avalonia 12 · PaddleOCR · ONNX Runtime"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <Button Grid.Column="1"
                    Content="关闭"
                    Click="OnCloseClick"
                    Width="80" />
        </Grid>
    </Grid>
</Window>
