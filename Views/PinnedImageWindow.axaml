<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShawMuOCR.Views.PinnedImageWindow"
        Title="置顶贴图"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyBackgroundFallback="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        SizeToContent="Manual"
        WindowStartupLocation="Manual">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="✏️ 再次编辑该图" Click="OnEditImageClick" />
            <MenuItem Header="📋 复制图片" Click="OnCopyImageClick" />
            <MenuItem Header="🔍 恢复 100% 原始大小" Click="OnResetZoomClick" />
            <Separator />
            <MenuItem Header="✕ 关闭 (Esc)" Click="OnCloseClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Name="RootBorder"
            Background="Transparent"
            ClipToBounds="True">
        <Panel Name="ImagePanel">
            <Image Name="PinnedImageControl"
                   Stretch="Fill"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />

            <!-- 置顶闪烁高亮提示边框 (像指示灯一样闪烁后缓缓暗下去提示位置) -->
            <Border Name="FlashHintBorder"
                    IsHitTestVisible="False"
                    BorderBrush="#00B4FF"
                    BorderThickness="3"
                    Background="#1800B4FF"
                    BoxShadow="inset 0 0 20 3 #9900B4FF, inset 0 0 6 2 #FFFFFF"
                    Opacity="0" />

            <!-- 悬浮缩放比例指示卡片 -->
            <Border Name="ScaleBadge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="8"
                    Background="#CC000000"
                    CornerRadius="4"
                    Padding="6,2"
                    IsVisible="False">
                <TextBlock Name="ScaleText"
                           Foreground="#EEEEEE"
                           FontSize="11"
                           Text="100%" />
            </Border>

            <!-- 右上角悬浮关闭按钮 (鼠标悬停时平滑显现) -->
            <Button Name="CloseBtn"
                    Classes="CloseHoverBtn"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="6"
                    Width="24"
                    Height="24"
                    CornerRadius="12"
                    Background="#88000000"
                    Foreground="White"
                    Content="✕"
                    FontSize="11"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Click="OnCloseClick"
                    ToolTip.Tip="关闭贴图 (Esc)" />
        </Panel>
    </Border>

    <Window.Styles>


        <Style Selector="Button#CloseBtn">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel#ImagePanel:pointerover Button#CloseBtn">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.CloseHoverBtn:hover">
            <Setter Property="Background" Value="#E81123" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>
</Window>
