<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:ShawMuOCR.ViewModels"
              xmlns:http="using:ShawMuOCR.Services.Http"
              x:Class="ShawMuOCR.Views.Pages.HttpApiPageView"
              x:DataType="vm:HttpApiViewModel">

    <UserControl.Styles>
        <!-- 主 TabControl 标题字号加大，层级更清晰醒目 -->
        <Style Selector="TabControl.main-tabs > TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
        </Style>

        <!-- 内部代码子 Tab (cURL / Python / C#) 标题紧凑协调 -->
        <Style Selector="TabControl.sub-tabs > TabItem">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3" />
        </Style>

        <!-- 默认兜底 TabItem 样式 -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Margin="0,0,6,12">

                <!-- 1. 顶部服务状态与控制栏 -->
                <Border Padding="16,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- 左侧：状态徽章与接口地址 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- 状态指示胶囊 -->
                    <Border Background="{Binding StatusBadgeColor}"
                            CornerRadius="12"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="●" FontSize="10" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusBadgeText}" FontWeight="SemiBold" FontSize="12" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 接口地址与复制按钮 -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="接口地址:" FontSize="13" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding EndpointUrl}"
                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Button Command="{Binding CopyEndpointCommand}"
                                Padding="8,5"
                                ToolTip.Tip="复制 OCR HTTP 接口地址">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="📋" FontSize="11" />
                                <TextBlock Text="复制" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 中间：状态反馈信息 -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Margin="16,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- 右侧：启动/停止切换按钮 -->
                <Button Grid.Column="2"
                        Command="{Binding ToggleServerCommand}"
                        Classes.accent="{Binding !IsRunning}"
                        Padding="18,8"
                        ToolTip.Tip="启动或停止本地嵌入式 HTTP OCR 服务">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IsRunning, Converter={x:Null}}"
                                   FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ToggleServerButtonText}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

                <!-- 2. 中间卡片：服务网络配置与 CPU 核心调度控制 -->
                <Grid ColumnDefinitions="*,12,*">
            <!-- 左卡片：网络与端口配置 -->
            <Border Grid.Column="0" Padding="14,10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="🌐 网络与端口配置" FontWeight="SemiBold" FontSize="13.5" />

                    <!-- 端口与单请求体大小上限双列配置 -->
                    <Grid ColumnDefinitions="*,10,*" VerticalAlignment="Center">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="服务端口:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding Port}"
                                           Minimum="1024"
                                           Maximum="65535"
                                           Increment="1"
                                           FormatString="F0"
                                           IsEnabled="{Binding IsSettingsEnabled}"
                                           VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Column="2" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="单请求上限:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding MaxRequestBodyMb}"
                                           Minimum="0"
                                           Maximum="2048"
                                           Increment="10"
                                           FormatString="F0"
                                           VerticalAlignment="Center"
                                           ToolTip.Tip="设置单次 HTTP 请求上传图片的最大体积（MB）。设置为 0 表示无限制大小（支持超大图片与长图批量调用）。" />
                        </Grid>
                    </Grid>

                    <!-- 参数说明与提示 -->
                    <TextBlock Text="{Binding MaxRequestBodyHint, StringFormat='💡 端口默认 8080；{0}'}"
                               FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <!-- 局域网访问开关 -->
                    <CheckBox IsChecked="{Binding AllowRemote}"
                              IsEnabled="{Binding IsSettingsEnabled}"
                              Content="允许局域网外部设备访问 (绑定 0.0.0.0)"
                              FontSize="12"
                              ToolTip.Tip="开启后允许同局域网内其他设备发起调用；若权限不足会自动回退至本地 127.0.0.1 模式。开启后强制要求访问令牌鉴权" />

                    <!-- 局域网可用地址提示 -->
                    <TextBlock Text="{Binding LanAccessHint}"
                               IsVisible="{Binding AllowRemote}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                    <!-- 接口鉴权主开关 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="接口令牌鉴权:" FontSize="12" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding EnableTokenAuth}"
                                      IsEnabled="{Binding IsSettingsEnabled}"
                                      OnContent="已开启"
                                      OffContent="已关闭 (免密)"
                                      FontSize="11.5"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <!-- 允许本机免令牌直连开关 -->
                    <CheckBox IsChecked="{Binding AllowLocalWithoutToken}"
                              IsEnabled="{Binding EnableTokenAuth}"
                              Content="允许本机免令牌直连 (127.0.0.1 免传 Header)"
                              FontSize="12"
                              ToolTip.Tip="开启后：在本机编写脚本、调用 cURL 时无需配置 Token；若从局域网外部设备调用，仍然强制校验 Token。" />

                    <!-- 访问令牌（配置后所有调用都需携带 Authorization: Bearer） -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" IsVisible="{Binding IsTokenRowVisible}" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="访问令牌:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding AccessToken}"
                                 PlaceholderText="未配置（仅本机直连可调用）"
                                 IsReadOnly="True"
                                 FontSize="11"
                                 FontFamily="Consolas"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="调用方需在请求头携带 Authorization: Bearer 加此令牌" />
                        <Button Grid.Column="2"
                                Content="复制"
                                Command="{Binding CopyAccessTokenCommand}"
                                FontSize="11"
                                Padding="8,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="3"
                                Content="重新生成"
                                Command="{Binding RegenerateAccessTokenCommand}"
                                IsEnabled="{Binding CanRegenerateToken}"
                                FontSize="11"
                                Padding="8,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center" />
                        <Button Grid.Column="4"
                                Content="清空"
                                Command="{Binding ClearAccessTokenCommand}"
                                IsEnabled="{Binding CanClearToken}"
                                FontSize="11"
                                Padding="8,2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="清空访问令牌（服务停止时可用）" />
                    </Grid>

                    <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,2" />

                    <!-- 接口规格说明 -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="📌 支持接口路由与输入协议:" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="• POST /ocr : 接收 multipart/form-data、JSON Base64 或纯图片二进制" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="• 支持 query 参数 ?splitColumns=true (分列) 与 ?format=text (纯文本)" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding SecurityHintText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 右卡片：CPU 核心并发与占空比限流调度 (公共调度器) -->
            <Border Grid.Column="2" Padding="14,10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SchedulerTitle}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeviceBadgeText}" FontSize="10" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveTasks, StringFormat='执行中: {0}'}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding QueuedTasks, StringFormat='排队中: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- 并发上限 Slider -->
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding ConcurrencyLabel}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding ConcurrencyValueText}" FontWeight="SemiBold" FontSize="12" />
                        </Grid>
                        <Slider Minimum="1"
                                Maximum="{Binding MaxAvailableCores}"
                                Value="{Binding MaxCores}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True" />
                    </StackPanel>

                    <!-- 利用率与负载上限 Slider -->
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding UsageLimitLabel}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding UsageLimitValueText}" FontWeight="SemiBold" FontSize="12" />
                        </Grid>
                        <Slider Minimum="10"
                                Maximum="100"
                                Value="{Binding CpuLimitPercent}"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True" />
                    </StackPanel>

                    <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,2" />

                    <!-- 调用统计指标 -->
                    <Grid ColumnDefinitions="*,*,*,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="总请求" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding TotalRequests}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="成功" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding SuccessRequests}" FontSize="14" FontWeight="SemiBold" Foreground="#107C41" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="失败" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding FailedRequests}" FontSize="14" FontWeight="SemiBold" Foreground="#D83B01" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="平均耗时" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding AvgElapsedMs, StringFormat='{}{0} ms'}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

                <!-- 3. 下部区域：调用示例与实时请求审计日志 (高度拓宽，主标题字号加大) -->
                <Border MinHeight="420"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
            <TabControl Classes="main-tabs" Margin="4">
                <!-- Tab 1: 代码调用示例 -->
                <TabItem Header="💻 快速调用示例 (cURL / Python / C#)">
                    <Grid RowDefinitions="Auto,*" Margin="8,6">
                        <!-- 令牌与鉴权专属操作栏 -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,10">
                            <StackPanel Spacing="8">
                                <!-- 顶栏：主开关与选项 -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- 左侧：开关与状态徽章 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="🔑" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="接口令牌鉴权:" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                        <ToggleSwitch IsChecked="{Binding EnableTokenAuth}"
                                                      IsEnabled="{Binding IsSettingsEnabled}"
                                                      OnContent="开启鉴权"
                                                      OffContent="关闭鉴权 (免密直连)"
                                                      FontSize="11.5"
                                                      VerticalAlignment="Center" />
                                        <Border Background="{Binding TokenBadgeColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TokenBadgeText}" FontSize="10.5" Foreground="White" FontWeight="Medium" />
                                        </Border>
                                    </StackPanel>

                                    <!-- 右侧：本机免令牌直连选项 -->
                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding AllowLocalWithoutToken}"
                                              IsEnabled="{Binding EnableTokenAuth}"
                                              Content="允许本机免令牌直连 (127.0.0.1 免传 Header)"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="开启后：本机编写脚本、调用 cURL 时无需配置 Token；若从局域网外部设备调用，仍然强制校验 Token。" />
                                </Grid>

                                <!-- 底栏：令牌展示与操作按钮 -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="访问令牌:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding AccessToken}"
                                             PlaceholderText="已关闭鉴权（所有接口免密调用）"
                                             IsReadOnly="True"
                                             IsEnabled="{Binding EnableTokenAuth}"
                                             FontSize="11.5"
                                             FontFamily="Consolas, Cascadia Code, Courier New"
                                             VerticalAlignment="Center"
                                             ToolTip.Tip="API 鉴权令牌。调用接口时需在请求头携带 Authorization: Bearer &lt;令牌&gt;" />
                                    <Button Grid.Column="2"
                                            Command="{Binding CopyAccessTokenCommand}"
                                            IsEnabled="{Binding EnableTokenAuth}"
                                            FontSize="11.5"
                                            Padding="10,4"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="复制当前访问令牌到剪贴板">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="📋" FontSize="11" />
                                            <TextBlock Text="复制令牌" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="3"
                                            Command="{Binding RegenerateAccessTokenCommand}"
                                            IsEnabled="{Binding CanRegenerateToken}"
                                            FontSize="11.5"
                                            Padding="10,4"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="重新生成一个高强度随机令牌（服务停止时可用）">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="🔄" FontSize="11" />
                                            <TextBlock Text="重新生成" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="4"
                                            Command="{Binding ClearAccessTokenCommand}"
                                            IsEnabled="{Binding CanClearToken}"
                                            FontSize="11.5"
                                            Padding="10,4"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="清空访问令牌（服务停止时可用）">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="🗑" FontSize="11" />
                                            <TextBlock Text="清空" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TabControl Classes="sub-tabs" Grid.Row="1">
                            <!-- cURL -->
                            <TabItem Header="cURL (命令行)">
                                <Grid RowDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBox Grid.Row="0"
                                             Text="{Binding CurlExample}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, Cascadia Code, Courier New"
                                             FontSize="12"
                                             MinHeight="200"
                                             TextWrapping="NoWrap"
                                             AcceptsReturn="True" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Command="{Binding CopyCurlCommandCommand}" Padding="12,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="📋" FontSize="12" />
                                                <TextBlock Text="复制 cURL 命令" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <!-- Python -->
                            <TabItem Header="Python (requests)">
                                <Grid RowDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBox Grid.Row="0"
                                             Text="{Binding PythonExample}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, Cascadia Code, Courier New"
                                             FontSize="12"
                                             MinHeight="200"
                                             TextWrapping="NoWrap"
                                             AcceptsReturn="True" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Command="{Binding CopyPythonCommandCommand}" Padding="12,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="📋" FontSize="12" />
                                                <TextBlock Text="复制 Python 代码" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <!-- C# -->
                            <TabItem Header="C# (.NET HttpClient)">
                                <Grid RowDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBox Grid.Row="0"
                                             Text="{Binding CsharpExample}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas, Cascadia Code, Courier New"
                                             FontSize="12"
                                             MinHeight="200"
                                             TextWrapping="NoWrap"
                                             AcceptsReturn="True" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Command="{Binding CopyCsharpCommandCommand}" Padding="12,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="📋" FontSize="12" />
                                                <TextBlock Text="复制 C# 代码" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <!-- Tab 2: 实时请求审计日志 -->
                <TabItem Header="📋 实时调用审计日志">
                    <Grid RowDefinitions="Auto,*" Margin="8,4">
                        <!-- 顶部操作条 -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Grid.Column="0"
                                       Text="显示服务端最近接收到的 HTTP 请求明细与识别状态："
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Command="{Binding ClearLogsCommand}"
                                    Padding="10,4"
                                    ToolTip.Tip="清空所有历史调用记录与统计指标">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🗑" FontSize="11" />
                                    <TextBlock Text="清空日志" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 日志列表 -->
                        <Border Grid.Row="1"
                                MinHeight="260"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <!-- 表头 -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        Padding="12,6"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="70,60,90,110,60,80,*">
                                        <TextBlock Grid.Column="0" Text="时间" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="方法" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="路径" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="3" Text="客户端 IP" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="4" Text="状态" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="5" Text="耗时" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Grid.Column="6" Text="识别结果与详情" FontWeight="SemiBold" FontSize="11" />
                                    </Grid>
                                </Border>

                                <!-- 数据滚动区 -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Logs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="http:HttpApiLogItem">
                                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="12,6"
                                                        Background="Transparent">
                                                    <Grid ColumnDefinitions="70,60,90,110,60,80,*">
                                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Method}" FontWeight="Medium" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Path}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding RemoteEndPoint}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="4" Background="{Binding StatusBadgeColor}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusCode}" FontSize="10" Foreground="White" FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Grid.Column="5" Text="{Binding ElapsedMs, StringFormat='{}{0} ms'}" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="6" Text="{Binding Message}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 多路并发/并发流安全提示遮罩弹窗 -->
        <Border Background="#60000000"
                IsVisible="{Binding IsConcurrencyWarningOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="100">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22,18"
                    Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 #30000000">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="18" Foreground="#D97706" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConcurrencyWarningTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding ConcurrencyWarningMessage}"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- 操作按钮 -->
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0"
                                Content="{Binding CancelConcurrencyButtonText}"
                                Command="{Binding CancelConcurrencyWarningCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,8" />
                        <Button Grid.Column="2"
                                Content="{Binding ConfirmConcurrencyButtonText}"
                                Command="{Binding ConfirmConcurrencyWarningCommand}"
                                Classes="accent"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,8" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
