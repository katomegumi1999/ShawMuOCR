<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MuRecorder.ViewModels"
             xmlns:audio="using:MuRecorder.Audio"
             xmlns:views="using:ShawMuOCR.Views"
             x:Class="ShawMuOCR.Views.Pages.RecordingPageView"
             x:DataType="vm:RecordingViewModel">

    <UserControl.Styles>
        <!-- 编码器探针：正常态跟随主题前景，告警态（将回退软编）用琥珀色点出来 -->
        <Style Selector="Border.encoder-probe TextBlock.probe-title">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Border.encoder-probe.warning TextBlock.probe-title">
            <Setter Property="Foreground" Value="#D97706" />
        </Style>
        <Style Selector="Border.encoder-probe.warning">
            <Setter Property="BorderBrush" Value="#F0B429" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <!-- 核心缺失降级提示 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="#F0B429"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    IsVisible="{Binding IsCoreUnavailable}">
                <StackPanel Spacing="4">
                    <TextBlock Text="⚠️ 录屏核心未就绪" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="未检测到 recorder_core.dll（Libs\x64\）。请重新编译 Rust 核心（C:\Rust\MuRecorder，scripts\build.ps1 会自动拷贝 DLL），或从官方发行包补全该文件后重启程序。"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" Margin="0,4">

                <!-- 左列：录制设置 -->
                <Border Grid.Column="0" Margin="0,0,8,0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        IsEnabled="{Binding CanConfigure}">
                    <StackPanel Spacing="14">

                        <TextBlock Text="录制设置" FontSize="15" FontWeight="SemiBold" />

                        <!-- 录制来源 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="录制来源" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel Spacing="4" Orientation="Horizontal">
                                <RadioButton GroupName="RecSource" IsChecked="{Binding IsSourceScreen}" Content="主显示器" />
                                <RadioButton GroupName="RecSource" IsChecked="{Binding IsSourceMonitor}" Content="指定显示器" />
                                <RadioButton GroupName="RecSource" IsChecked="{Binding IsSourceWindow}" Content="指定窗口" />
                                <RadioButton GroupName="RecSource" IsChecked="{Binding IsSourceRegion}" Content="自定义区域" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 显示器选择 -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsSourceMonitor}">
                            <TextBlock Text="目标显示器" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding Monitors}"
                                      SelectedItem="{Binding SelectedMonitor}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- 窗口选择（支持多选合并） -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsSourceWindow}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="目标窗口（支持多选合并）" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="全选" FontSize="11" Padding="6,2"
                                        Command="{Binding SelectAllWindowsCommand}" />
                                <Button Grid.Column="2" Content="清空" FontSize="11" Padding="6,2"
                                        Command="{Binding ClearSelectedWindowsCommand}" />
                                <Button Grid.Column="3" Content="刷新" FontSize="11" Padding="6,2"
                                        Command="{Binding RefreshSourcesCommand}" />
                            </Grid>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2">
                                <ListBox ItemsSource="{Binding Windows}"
                                         MaxHeight="160"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SelectableWindowItem">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="2,1">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Window.Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               FontSize="12" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Window.ProcessName}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{Binding SelectedWindowsSummary}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="提示：勾选多个窗口将自动计算并集合成外接矩形区域，点击下方【开始录制】即可录制所选窗口内容。"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 自定义区域 -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsSourceRegion}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="框选区域（物理像素）" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" Content="显示区域边界线" IsChecked="{Binding ShowRegionBorder}" FontSize="12" />
                            </Grid>
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6" Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding RegionText}" VerticalAlignment="Center" FontSize="12" />
                                    <Button Grid.Column="1" Content="📐 框选区域" Command="{Binding SelectRegionCommand}" Classes="accent" />
                                </Grid>
                            </Border>
                            <TextBlock Text="点击后拖拽框选录制区域（ESC 或右键取消）；屏幕上将以辉光外边框标记录制边界，确认后点击【▶ 开始录制】即可开录。"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 鼠标与光标特效配置 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="鼠标与演示特效" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="6" ColumnSpacing="10">
                                <CheckBox Grid.Row="0" Grid.Column="0"
                                          Content="捕获鼠标指针" IsChecked="{Binding CaptureCursor}" FontSize="12"
                                          ToolTip.Tip="在录制的视频画面中合成系统鼠标指针" />
                                <CheckBox Grid.Row="0" Grid.Column="1"
                                          Content="点击波纹特效" IsChecked="{Binding CursorClickEffect}" IsEnabled="{Binding CaptureCursor}" FontSize="12"
                                          ToolTip.Tip="鼠标点击处渲染扩散圆环动画" />
                                <CheckBox Grid.Row="1" Grid.Column="0"
                                          Content="桌面实时呈现特效（演示模式）" IsChecked="{Binding LiveCursorEffect}" IsEnabled="{Binding CaptureCursor}" FontSize="12"
                                          ToolTip.Tip="开启后录屏期间在您的物理屏幕上也实时呈现点击波纹与流光光轨（教学演示模式）；关闭后屏幕无干扰，由录屏引擎硬件直接合成进视频" />
                                <CheckBox Grid.Row="1" Grid.Column="1"
                                          Content="移动流光光轨" IsChecked="{Binding CursorTrail}" IsEnabled="{Binding CaptureCursor}" FontSize="12"
                                          ToolTip.Tip="鼠标移动时沿历史路径生成连续平滑收窄的霓虹流光光轨" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding CursorTrail}">
                                <TextBlock Grid.Column="0" Text="拖尾时长" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="40" Maximum="1000" Value="{Binding CursorTrailMs}" SmallChange="10" LargeChange="50" TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding CursorTrailMs, StringFormat={}{0} ms}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Width="55" />
                            </Grid>
                        </StackPanel>

                        <!-- 开录后的桌面行为 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="开录后的桌面行为" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <CheckBox Content="开录后最小化主窗口"
                                      IsChecked="{Binding MinimizeOnStart}"
                                      FontSize="12"
                                      ToolTip.Tip="勾选：点开始录制后主窗口立即收进任务栏，把桌面完整让给录制内容。不勾选：主窗口留在原地（适合边讲解边看界面，或录制目标就是本程序）。停止录制时点任务栏恢复窗口即可。" />
                            <CheckBox Content="开录后显示悬浮控制条"
                                      IsChecked="{Binding IsFloatingBarEnabled}"
                                      FontSize="12"
                                      ToolTip.Tip="勾选：开始录制时在桌面显示悬浮控制条（带停止按钮）。不勾选：开录后桌面不弹任何浮层；需要临时操作时按录屏热键（默认 Alt+R）呼出控制条。与上方「最小化」开关互不影响。" />
                        </StackPanel>

                        <!-- 帧率 / 码率 -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="帧率" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding FpsOptions}"
                                          SelectedItem="{Binding SelectedFps}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="码率" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding BitrateOptions}"
                                          SelectedItem="{Binding SelectedBitrate}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- 编码器 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="编码器" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding EncoderOptions}"
                                      SelectedItem="{Binding SelectedEncoder}"
                                      HorizontalAlignment="Stretch" />

                            <!-- 编码器探针：把「自动检测」的实际落点提前显示出来。
                                 录制中隐藏 —— 那时右侧统计区显示的是真实编码器，
                                 探针仍写「预计」会与事实打架。 -->
                            <Border Classes="encoder-probe"
                                    Classes.warning="{Binding EncoderProbeIsWarning}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    IsVisible="{Binding !IsRecording}">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="probe-title"
                                               Text="{Binding EncoderProbeTitle}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding EncoderProbeHint}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="默认开启 GPU H.265 (HEVC) 显存零拷贝硬件加速；可选 GPU H.264 或 CPU 软编。若环境不支持硬编将自动安全降级。"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 音频预设与设备多选列表 -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="音频录制" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="🔄 刷新设备" FontSize="11" Padding="8,3"
                                        Command="{Binding RefreshAudioDevicesCommand}" />
                            </Grid>

                            <!-- 预设选择（快速配置） -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="音频预设" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <ComboBox ItemsSource="{Binding AudioPresetOptions}"
                                          SelectedItem="{Binding SelectedAudioPreset}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- 麦克风叠加增益：仅在「系统声音 + 麦克风」时出现 -->
                            <StackPanel Spacing="2" IsVisible="{Binding IsMicOverlayActive}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="麦克风音量（与系统声音混合）" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding MicGainLabel}" FontSize="11"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Slider Minimum="10" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding MicGainPercent}" />
                            </StackPanel>

                            <!-- 所有设备平铺遍历列表（带 CheckBox 多选勾选） -->
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="音频设备列表（未勾选则不录声音）" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding AudioSelectedSummary}" FontSize="11"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="未检测到活跃的音频设备（声卡未就绪）"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   IsVisible="{Binding !HasAudioDevices}"
                                                   Margin="4,6" />
                                        <ItemsControl ItemsSource="{Binding AudioDeviceList}"
                                                      IsVisible="{Binding HasAudioDevices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="audio:SelectableAudioDevice">
                                                    <Border Padding="4,3" Margin="0,1" CornerRadius="4">
                                                        <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Stretch">
                                                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="4,0,0,0">
                                                                <TextBlock Grid.Column="0" Text="{Binding FlowIcon}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <Border Grid.Column="1" Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                                        CornerRadius="3" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding FlowLabel}" FontSize="10"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="12"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </CheckBox>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- 文件名前缀 -->
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="文件名前缀" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="默认：MuRecorder" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox Text="{Binding FilePrefix}" PlaceholderText="MuRecorder" />
                        </StackPanel>

                        <!-- 输出路径 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="输出文件（.mp4）" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0" Text="{Binding OutputPath}" PlaceholderText="保存路径" />
                                <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseOutputCommand}" />
                                <Button Grid.Column="2" Content="打开目录" Command="{Binding OpenOutputFolderCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 右列：控制台 + 实时统计 -->
                <Border Grid.Column="1" Margin="8,0,0,0"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <TextBlock Grid.Row="0" Text="录制控制台" FontSize="15" FontWeight="SemiBold" />

                        <!-- 开始 / 停止 / 区域录制 -->
                        <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,0">
                            <Button Content="⏺  开始录制"
                                    Command="{Binding StartRecordingCommand}"
                                    Classes="accent"
                                    IsEnabled="{Binding IsCoreAvailable}"
                                    IsVisible="{Binding !IsRecording}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="12,10"
                                    FontSize="14" />
                            <Button Content="📐  框选并录制"
                                    Command="{Binding SelectRegionAndRecordCommand}"
                                    Classes="subtle"
                                    IsEnabled="{Binding IsCoreAvailable}"
                                    IsVisible="{Binding !IsRecording}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="12,9"
                                    FontSize="13"
                                    ToolTip.Tip="拖拽框选屏幕任意录制区域，选定后立即开始录制" />
                            <Button Content="⏹  停止录制"
                                    Command="{Binding StopRecordingCommand}"
                                    IsVisible="{Binding IsRecording}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="12,10"
                                    FontSize="14" />

                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />

                            <Border Background="#C42B1C11"
                                    BorderBrush="#C42B1C"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding ErrorMessage}"
                                           FontSize="12"
                                           Foreground="#C42B1C"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- 实时统计 (每行四列) -->
                        <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                            <TextBlock Text="实时统计" FontSize="13" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="帧率" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StatFps}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="码率" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StatBitrate}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="已录时长" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StatElapsed}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="编码器" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StatEncoder}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="已编码帧" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StatFrames}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="丢弃帧数" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StatDropped}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="编码积压" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StatQueue}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="6,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="目标尺寸" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StatResolution}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- 实时录制画面硬件直通预览 (等比自适应缩放) -->
                        <StackPanel Grid.Row="3" Spacing="8" Margin="0,16,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="实时画面预览" FontSize="13" FontWeight="SemiBold" />
                                <Border Grid.Column="1" Background="#2638D9A9" CornerRadius="4" Padding="5,1" IsVisible="{Binding IsRecording}">
                                    <TextBlock Text="D3D11 直通" Foreground="#38D9A9" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <Border Background="#121214"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    Height="230">
                                <Panel>
                                    <views:RecordingPreviewControl x:Name="PreviewHost"
                                                                  TargetAspectRatio="{Binding TargetAspectRatio}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  IsVisible="{Binding IsRecording}" />

                                    <!-- 未在录制时的占位提示 -->
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                                                IsVisible="{Binding !IsRecording}">
                                        <TextBlock Text="🎥" FontSize="26" HorizontalAlignment="Center" Opacity="0.5" />
                                        <TextBlock Text="开录后在此硬件直通预览"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="原比例自适应缩放 · 0ms 显卡直通"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 技术说明卡片 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="架构与质量说明" FontWeight="SemiBold" FontSize="14" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="🧱 薄壳架构" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="C# 仅负责枚举、选区、配置组装与状态展示；捕获、编码、封装、线程调度全部在 Rust 核心内闭环，FFI 只有控制命令与 200ms 统计快照。"
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="⚙️ 四线程流水线" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="捕获 / 编码 / 封装 / 统计各自独立线程，有界环形队列满即丢帧（绝不反压 UI），QPC 统一时钟配速。"
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="📦 faststart MP4" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="流式写入 mdat，停止时原位回填 moov（co64 64 位偏移，无 4GB 上限），停止即完整可播，异常中断也会尽力收尾。"
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="🛡️ 设备丢失自恢复" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="分辨率切换 / 显卡驱动重置导致 DXGI 设备丢失时，自动重建捕获链（10 次 × 500ms），全过程不崩进程。"
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
