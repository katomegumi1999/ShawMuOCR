<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShawMuOCR.ViewModels"
             xmlns:components="using:ShawMuOCR.Views.Components"
             x:Class="ShawMuOCR.Views.Pages.OcrPageView"
             x:DataType="vm:MainViewModel"
             DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,*" Background="Transparent">
        <!-- 顶部操作与信息条 (状态指标 + 重新识别/打开文件入口) -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <!-- 左侧指标信息 (通过 Grid 严格划分空间，状态自适应填充 + 省略号截断，杜绝与右侧按钮重叠) -->
                <Grid Grid.Column="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,16,0" VerticalAlignment="Center">
                    <!-- 状态 -->
                    <DockPanel Grid.Column="0" LastChildFill="True" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="状态: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding StatusMessage}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- 耗时 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="耗时:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ElapsedText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 字数 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="字数:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CharCount}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- 右侧快捷与文件操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 重新识别按钮 (新增) -->
                    <Button Command="{Binding ReRecognizePreviewImageCommand}"
                            Classes="accent"
                            Padding="12,6"
                            ToolTip.Tip="直接对当前预览区中的图像重新执行一次 OCR 文字识别">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="重新识别" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 核心操作: 打开文件 -->
                    <Button Command="{Binding OpenFileCommand}"
                            Padding="12,6"
                            ToolTip.Tip="打开本地图片或 PDF 文档进行文字识别">
                        <TextBlock Text="打开文件" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </Button>

                    <!-- 辅助操作: 复制全文 -->
                    <Button Content="复制全文"
                            Command="{Binding CopyTextCommand}"
                            Padding="10,6"
                            ToolTip.Tip="复制识别出的所有文字到剪贴板" />

                    <!-- 辅助操作: 清空 -->
                    <Button Content="清空"
                            Command="{Binding ClearCommand}"
                            Padding="10,6"
                            ToolTip.Tip="清空预览图与识别文本" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主工作区：左侧预览，右侧文字 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,1.2*">
            <!-- 左栏：截图/PDF 预览 (使用统一抽取的预览组件) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True"
                    DragDrop.AllowDrop="True">
                <components:ImageDocumentPreviewControl Source="{Binding PreviewImage}"
                                                        HeaderTitle="图像/文档预览 (支持拖拽图片或 PDF 至此)"
                                                        RotateCommand="{Binding RotatePreviewImageCommand}"
                                                        SaveCommand="{Binding SavePreviewImageCommand}" />
            </Border>

            <!-- 分割条 -->
            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

            <!-- 右栏：OCR 识别文本结果 -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12,8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="识别文本 (可直接编辑修改)" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding CharCount, StringFormat='共 {0} 字符'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <TextBox Grid.Row="1"
                             Text="{Binding RecognizedText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             Padding="12" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
