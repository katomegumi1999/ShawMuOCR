<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShawMuOCR.ViewModels"
             x:Class="ShawMuOCR.Views.Pages.SettingsPageView"
             x:DataType="vm:SettingsViewModel">

    <Panel>
    <Grid RowDefinitions="Auto,*">
        <!-- 顶部操作栏 (Topbar) -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                        Content="↺ 恢复默认设置"
                        Command="{Binding ShowResetConfirmDialogCommand}"
                        Classes="subtle"
                        Padding="12,6"
                        FontSize="12"
                        ToolTip.Tip="将所有设置项还原为出厂默认设置" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="14,0,16,0">
                    <TextBlock Text="💡" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding !IsRecordingAnyHotkey}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               IsVisible="{Binding !IsRecordingAnyHotkey}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="保存设置"
                        Command="{Binding SaveCommand}"
                        Classes="accent"
                        Padding="14,6"
                        Margin="0,0,8,0" />

                <Button Grid.Column="3"
                        Content="取消"
                        Command="{Binding CancelCommand}"
                        Padding="14,6" />
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- 常规与快捷键设置卡片 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="常规与快捷键设置" FontWeight="SemiBold" FontSize="15" />

                        <!-- 快捷键录制提示条（录制中高亮显示，全宽包裹防挤压） -->
                        <Border Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                BorderBrush="{DynamicResource AccentStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                IsVisible="{Binding IsRecordingAnyHotkey}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="⌨" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusMessage}"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Content="取消 (Esc)"
                                        Command="{Binding CancelRecordingCommand}"
                                        Padding="8,4"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 快捷键 1: 截图 OCR -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="截图 OCR 全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="唤起全屏框选截屏并执行文字识别"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding Hotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                         Command="{Binding StartRecordHotkeyCommand}"
                                         Padding="10,5" />
                                <Button Content="✕"
                                         ToolTip.Tip="清空此快捷键(禁用)"
                                         Command="{Binding ClearHotkeyCommand}"
                                         Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 2: 截图复制 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="截图复制全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="框选后直接将截取的图像写入系统剪贴板"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding CaptureImageHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                         Command="{Binding StartRecordCaptureImageHotkeyCommand}"
                                         Padding="10,5" />
                                <Button Content="✕"
                                         ToolTip.Tip="清空此快捷键(禁用)"
                                         Command="{Binding ClearCaptureImageHotkeyCommand}"
                                         Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 3: 截图标注 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="截图标注全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="框选后打开画图编辑器（支持画线、箭头、矩形、文字与置顶贴图）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding AnnotateHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                         Command="{Binding StartRecordAnnotateHotkeyCommand}"
                                         Padding="10,5" />
                                <Button Content="✕"
                                         ToolTip.Tip="清空此快捷键(禁用)"
                                         Command="{Binding ClearAnnotateHotkeyCommand}"
                                         Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 4: 截图快存 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="截图快存全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="框选后直接保存到目标文件夹（默认 Alt+S）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding QuickSaveHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                         Command="{Binding StartRecordQuickSaveHotkeyCommand}"
                                         Padding="10,5" />
                                <Button Content="✕"
                                         ToolTip.Tip="清空此快捷键(禁用)"
                                         Command="{Binding ClearQuickSaveHotkeyCommand}"
                                         Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 5: 长截屏 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="长截屏全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="框选区域后滚动窗口连续拼接长图并自动复制到剪贴板（默认 Alt+L）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding LongScreenshotHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                         Command="{Binding StartRecordLongScreenshotHotkeyCommand}"
                                         Padding="10,5" />
                                <Button Content="✕"
                                         ToolTip.Tip="清空此快捷键(禁用)"
                                         Command="{Binding ClearLongScreenshotHotkeyCommand}"
                                         Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 5: 屏幕录制 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="屏幕录制全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="唤起录屏桌面悬浮控制条或框选区域开始录制（默认 Alt+R）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding RecordingHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                         Command="{Binding StartRecordRecordingHotkeyCommand}"
                                         Padding="10,5" />
                                <Button Content="✕"
                                         ToolTip.Tip="清空此快捷键(禁用)"
                                         Command="{Binding ClearRecordingHotkeyCommand}"
                                         Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 6: 选区翻译 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="选区翻译全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="框选屏幕任意区域后提取文字并在侧边浮窗直接翻译"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding TranslateHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                         Command="{Binding StartRecordTranslateHotkeyCommand}"
                                         Padding="10,5" />
                                <Button Content="✕"
                                         ToolTip.Tip="清空此快捷键(禁用)"
                                         Command="{Binding ClearTranslateHotkeyCommand}"
                                         Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 5: OCR 窗格 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="OCR 窗格全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="框选屏幕区域后识别文字并在悬浮窗格中显示结果（不自动复制）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding OcrPopupHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                         Command="{Binding StartRecordOcrPopupHotkeyCommand}"
                                         Padding="10,5" />
                                <Button Content="✕"
                                         ToolTip.Tip="清空此快捷键(禁用)"
                                         Command="{Binding ClearOcrPopupHotkeyCommand}"
                                         Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 6: 随手便笺 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="随手便笺全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="快捷呼出一个极简悬浮输入面板，支持快速记录、保存常用语与一键复制"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding QuickNoteHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                         Command="{Binding StartRecordQuickNoteHotkeyCommand}"
                                         Padding="10,5" />
                                <Button Content="✕"
                                         ToolTip.Tip="清空此快捷键(禁用)"
                                         Command="{Binding ClearQuickNoteHotkeyCommand}"
                                         Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 长截图高级设置：长截图高度上限 (独立隔开) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="长截图高度上限" FontWeight="Medium" />
                                <TextBlock Text="单张长图的最大高度（像素）。触顶会自动收尾，后面的内容不再收入；调高更吃内存（16000 高 × 1920 宽约 123 MB）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableLongScreenshotHeights}"
                                      SelectedItem="{Binding LongScreenshotMaxHeight}"
                                      Width="160" />
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 行为开关 -->
                        <CheckBox Content="OCR 识别完成后自动复制文本到剪贴板"
                                  IsChecked="{Binding AutoCopy}" />

                        <CheckBox Content="表格智能分列（识别到表格时，粘贴到 Excel / WPS 自动落入单元格）"
                                  IsChecked="{Binding AutoCopyTableAsCells}"
                                  IsEnabled="{Binding AutoCopy}"
                                  Margin="26,0,0,0"
                                  ToolTip.Tip="开启后，若识别结果呈表格结构（多行多列、各列按检测框垂直对齐），剪贴板会同时写入 HTML 表格与纯文本两种格式：粘贴到 Excel / WPS / Word 时还原为真正的单元格（空单元格留空、合并表头保留跨列、列不错位），粘贴到聊天窗口、记事本、搜索框时只得到干净的纯文本，不会出现制表符空档。截图中有表格框线时会直接按框线分列，最稳定；没有框线才按文字检测框的位置推断。关闭则一律使用原有空格分隔文本。" />

                        <CheckBox Content="静默模式（识别完成后不弹出主界面）"
                                  IsChecked="{Binding SilentMode}" />

                        <CheckBox Content="静默启动（启动后直接最小化至系统托盘，不显示主界面）"
                                  IsChecked="{Binding SilentStartup}" />

                        <CheckBox Content="OCR 识别气泡提醒（在屏幕底部弹出文字摘要与耗时统计）"
                                  IsChecked="{Binding ShowOcrNotification}" />

                        <CheckBox Content="截图复制气泡提醒（在屏幕底部弹出截图复制成功提示）"
                                  IsChecked="{Binding ShowCaptureImageNotification}" />

                        <CheckBox Content="开机自启动"
                                  IsChecked="{Binding StartWithWindows}" />
                    </StackPanel>
                </Border>

                <!-- 小沐剪贴板设置卡片 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Image Source="avares://ShawMuOCR/Assets/MuClip.png" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="小沐剪贴板" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding EnableClipboard}"
                                          OnContent="已开启"
                                          OffContent="已关闭"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="极速剪贴板历史记录与常用语管理，支持局域网免密/PIN加密互传与键入光标处快捷面板。默认关闭，开启后方在主界面显示入口并加载后台服务。"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <!-- 快捷键配置（仅在开启后显示） -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding EnableClipboard}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="小沐剪贴板全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="在当前光标键入位置直接呼出无边框悬浮快捷面板（默认 Alt+Q）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding ClipboardPanelHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                        Command="{Binding StartRecordClipboardPanelHotkeyCommand}"
                                        Padding="10,5" />
                                <Button Content="✕"
                                        ToolTip.Tip="清空此快捷键(禁用)"
                                        Command="{Binding ClearClipboardPanelHotkeyCommand}"
                                        Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 常用语快捷键配置（仅在开启后显示） -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding EnableClipboard}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="常用语快捷呼出键" FontWeight="Medium" />
                                <TextBlock Text="直接呼出常用语列面板，快速选用常用语句（默认 Alt+W）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding PhrasesPanelHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                        Command="{Binding StartRecordPhrasesPanelHotkeyCommand}"
                                        Padding="10,5" />
                                <Button Content="✕"
                                        ToolTip.Tip="清空此快捷键(禁用)"
                                        Command="{Binding ClearPhrasesPanelHotkeyCommand}"
                                        Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 悬浮快捷面板底色配置（仅在开启后显示） -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding EnableClipboard}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="快捷面板背景底色" FontWeight="Medium" />
                                <TextBlock Text="设置悬浮快捷面板卡片的背景底色（默认 #F4F4F6 浅灰）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding ClipboardPanelBackground, Mode=TwoWay}"
                                         Width="100"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 小沐剪贴板数据目录（仅在开启后显示） -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding EnableClipboard}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="小沐剪贴板数据目录 (%LocalAppData%\ShawMuOCR\Muclip)" FontWeight="Medium" />
                                <TextBox Text="{Binding MuClipDataDirectory}"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         Margin="0,6,0,0"
                                         VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="打开目录"
                                        Command="{Binding OpenMuClipDataFolderCommand}"
                                        Padding="10,5" />
                                <Button Content="复制路径"
                                        Command="{Binding CopyMuClipDataPathCommand}"
                                        Padding="10,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 本地库加密状态（仅在开启后显示） -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding EnableClipboard}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="本地数据库加密状态" FontWeight="Medium" />
                                <TextBlock Text="{Binding MuClipEncryptionStatus}"
                                           FontSize="13"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MuClipEncryptionDetail}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="重新检测"
                                    Command="{Binding RefreshMuClipEncryptionStatusCommand}"
                                    Padding="10,5"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- 数据库自动备份与定期清理（仅在开启后显示） -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding EnableClipboard}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="数据库自动快照与滚动清理" FontWeight="Medium" />
                                <TextBlock Text="后台定期为加密数据库生成滚动快照，并在达到保留上限时自动清理最旧快照，安全防灾"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="每" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding AvailableClipboardAutoBackupIntervalHours}"
                                          SelectedItem="{Binding ClipboardAutoBackupIntervalHours}"
                                          Width="75" />
                                <TextBlock Text="小时备份，保留" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding AvailableClipboardAutoBackupKeeps}"
                                          SelectedItem="{Binding ClipboardAutoBackupKeep}"
                                          Width="70" />
                                <TextBlock Text="份" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Content="打开备份目录"
                                        Command="{Binding OpenMuClipAutoBackupFolderCommand}"
                                        Padding="10,5"
                                        ToolTip.Tip="打开滚动快照存储目录 (%LocalAppData%\ShawMuOCR\Muclip\auto-backup)" />
                                <Button Content="立即快照"
                                        Command="{Binding TriggerMuClipAutoBackupCommand}"
                                        Padding="10,5"
                                        ToolTip.Tip="立即执行一次数据库快照，并按保留策略清理历史快照" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OCR 模型设置 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="OCR 引擎与模型设置" FontWeight="SemiBold" FontSize="15" />

                        <!-- 统一 AI 接口池：翻译与 OCR 共用的节点列表 -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="AI 接口池" FontWeight="Medium" />
                                        <TextBlock Text="在这里添加任意多个 OpenAI 兼容接口（地址填到 /v1 为止）。翻译与 OCR 各自从中选一个节点，用量按节点统一记账。"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="＋ 添加节点" Command="{Binding AddAiNodeCommand}" Padding="10,5" FontSize="12" />
                                        <Button Content="删除" Command="{Binding RemoveAiNodeCommand}" CommandParameter="{Binding SelectedAiNode}" Padding="10,5" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <ComboBox ItemsSource="{Binding AiNodes}"
                                          SelectedItem="{Binding SelectedAiNode}"
                                          PlaceholderText="还没有节点，点右上角「添加节点」"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AiNodeViewModel">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <StackPanel Spacing="8" IsVisible="{Binding HasSelectedAiNode}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="名称" VerticalAlignment="Center" FontSize="12" Width="56" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedAiNode.Name}" FontSize="12" PlaceholderText="例如：通义千问" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="接口地址" VerticalAlignment="Center" FontSize="12" Width="56" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedAiNode.BaseUrl}" FontSize="12" PlaceholderText="https://api.openai.com/v1" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="模型" VerticalAlignment="Center" FontSize="12" Width="56" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedAiNode.Model}" FontSize="12" PlaceholderText="qwen-vl-max" />
                                        <TextBlock Grid.Column="2" Text="月额度" VerticalAlignment="Center" FontSize="12" />
                                        <NumericUpDown Grid.Column="3"
                                                       Value="{Binding SelectedAiNode.MonthlyTokenLimit}"
                                                       Minimum="0" Maximum="100000000" Increment="10000"
                                                       FormatString="N0" FontSize="12" Width="130" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="API Key" VerticalAlignment="Center" FontSize="12" Width="56" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedAiNode.ApiKey}" PasswordChar="*" FontSize="12" PlaceholderText="sk-..." />
                                    </Grid>
                                    <CheckBox Content="支持图片输入（可被 OCR 选用）"
                                              IsChecked="{Binding SelectedAiNode.SupportsVision}"
                                              FontSize="12" />
                                    <TextBlock Text="{Binding SelectedAiNode.QuotaText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- OCR 使用哪个节点 -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="使用 AI 视觉接口识别" FontWeight="Medium" />
                                        <TextBlock Text="把图片直接发给多模态大模型，由提示词决定要做什么。适用于复杂版面、手写、公式；单次延迟与费用均高于本地模型。批量转换会自动使用同一设置。"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding UseAiApiOcr}"
                                                  OnContent="AI 接口"
                                                  OffContent="本地模型"
                                                  VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Spacing="10" IsVisible="{Binding ShowAiOcrSettings}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Text="选用节点" VerticalAlignment="Center" FontSize="12" Width="56" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding VisionAiNodes}"
                                                  SelectedItem="{Binding SelectedOcrAiNode}"
                                                  PlaceholderText="没有勾选「支持图片输入」的节点"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AiNodeViewModel">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="识别提示词" FontSize="12" />
                                            <Button Grid.Column="1"
                                                    Content="恢复默认"
                                                    Command="{Binding ResetAiOcrPromptCommand}"
                                                    Padding="8,2"
                                                    FontSize="11"
                                                    Classes="subtle" />
                                        </Grid>
                                        <TextBox Text="{Binding AiVisionPromptText}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="96"
                                                 MaxHeight="160"
                                                 FontSize="12"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        <TextBlock Text="提示词决定输出内容：默认只做文字识别；也可以改成「提取表格并输出 CSV」「把公式转成 LaTeX」等任务。"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Text="注意：启用后所有识别（截图、批量转换、对外 HTTP 接口）都会把图片发送到所选节点，不再在本机完成。"
                                               FontSize="11"
                                               Foreground="#D83B01"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 模型选择：直接读取同目录下的 models 文件夹 -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="12"
                                IsVisible="{Binding !UseAiApiOcr}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="OCR 推理模型" FontWeight="Medium" />
                                    <TextBlock Text="{Binding ModelSelectionHint}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding AvailableModels}"
                                              SelectedItem="{Binding SelectedModel}"
                                              IsEnabled="{Binding HasAvailableModels}"
                                              PlaceholderText="未检测到可用模型"
                                              MinWidth="180" />
                                    <Button Content="🔄"
                                            ToolTip.Tip="重新扫描 models 目录"
                                            Command="{Binding RefreshModelsCommand}"
                                            Padding="8,5" />
                                    <Button Content="📂"
                                            ToolTip.Tip="打开 models 文件夹"
                                            Command="{Binding OpenModelsFolderCommand}"
                                            Padding="8,5" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 未检测到任何模型时的醒目提醒 -->
                        <Border Background="#26D83B01"
                                BorderBrush="#80D83B01"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                IsVisible="{Binding ShowNoModelsWarning}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="⚠️" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="未检测到任何 OCR 模型文件" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="本程序默认不内置模型，请将随程序分发的 models 文件夹放置在与主程序同一目录下，然后点击“🔄”重新扫描。"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="打开目录"
                                        Command="{Binding OpenModelsFolderCommand}"
                                        Padding="8,4"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 推理加速后端 (Auto / GPU Vulkan / CPU SIMD) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="推理加速后端 (GPU / CPU)" FontWeight="Medium" />
                                <TextBlock Text="{Binding OcrBackendHint}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableOcrBackends}"
                                      SelectedItem="{Binding SelectedOcrBackendOption}"
                                      MinWidth="180"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Auto 模式下实时回报当前自动选中的模式 -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="12,8"
                                IsVisible="{Binding IsAutoBackendSelected}">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="当前自动选择模式："
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AutoResolvedBackendText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding AutoResolvedReasonText, StringFormat='判定依据：{0}'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 物理显卡手动选择 (独显 / 核显) -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowGpuDeviceSelector}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="选择物理显卡 (GPU 设备)" FontWeight="Medium" />
                                <TextBlock Text="支持在独立显卡 ([独显]) 与集成显卡 ([核显]) 之间手动指定，默认优先使用独立显卡"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableGpuDevices}"
                                      SelectedItem="{Binding SelectedGpuDeviceOption}"
                                      MinWidth="240"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 最大检测边长 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="文本检测最大长边限制" FontWeight="Medium" />
                                <TextBlock Text="超限将等比缩放送检，字符识别仍用高清原图（推荐 1280）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableMaxSideLens}"
                                      SelectedItem="{Binding MaxSideLen}"
                                      Width="160" />
                        </Grid>

                        <!-- 文字方向检测开关 -->
                        <CheckBox Content="开启文字方向角度检测（识别倒立文字；关闭可节省约 150MB 内存）"
                                  IsChecked="{Binding EnableAngleDetection}" />

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 闲置自动休眠 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="闲置自动休眠释放内存" FontWeight="Medium" />
                                <TextBlock Text="无截屏操作达到指定时长时，自动深度释放物理内存池"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <CheckBox Content="启用" IsChecked="{Binding EnableIdleSleep}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding AvailableIdleSleepMinutes}"
                                          SelectedItem="{Binding IdleSleepMinutes}"
                                          IsEnabled="{Binding EnableIdleSleep}"
                                          Width="90" />
                                <TextBlock Text="分钟" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 翻译服务与接口额度设置 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="翻译服务与接口额度设置" FontWeight="SemiBold" FontSize="15" />

                        <!-- 默认提供商与语言方向 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="默认翻译提供商与语言方向" FontWeight="Medium" />
                                <TextBlock Text="配置选区翻译默认生效的翻译接口与语言代码"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding AvailableTranslateProviders}"
                                          SelectedItem="{Binding SelectedTranslateProvider}"
                                          Width="110">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox ItemsSource="{Binding TranslateSourceLanguages}"
                                          SelectedItem="{Binding SelectedTranslateSourceLang}"
                                          Width="110">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="➔" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding TranslateTargetLanguages}"
                                          SelectedItem="{Binding SelectedTranslateTargetLang}"
                                          Width="110">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 1. 百度翻译 API 配置 -->
                        <Expander Header="百度翻译 API (智能双模：支持大模型 aiTextTranslate 与通用翻译，每月默认 100 万字符)" IsExpanded="True" Padding="8,6">
                            <StackPanel Spacing="10" Margin="0,4,0,0">
                                <Grid ColumnDefinitions="140,*,140,*">
                                    <TextBlock Grid.Column="0" Text="App ID:" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding BaiduAppId}" Margin="0,0,12,0" FontSize="12" PlaceholderText="百度开放平台 App ID (17位数字)" />
                                    <TextBlock Grid.Column="2" Text="密钥 (Secret Key):" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="3" Text="{Binding BaiduSecretKey}" PasswordChar="*" FontSize="12" PlaceholderText="开发者信息中的密钥" />
                                </Grid>
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="API Key (Bearer):" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding BaiduApiKey}" PasswordChar="*" FontSize="12" PlaceholderText="【API Key管理】创建的 Key (使用大模型翻译时填写)" />
                                </Grid>
                                <Grid ColumnDefinitions="140,*,Auto">
                                    <TextBlock Grid.Column="0" Text="每月字符上限:" VerticalAlignment="Center" FontSize="12" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding BaiduMonthlyLimit}" Minimum="0" Maximum="10000000" Increment="50000" FormatString="N0" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BaiduUsedCount, StringFormat='当月已用: {0:N0} 字符'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Button Content="重置计数" Command="{Binding ResetBaiduUsedCountCommand}" Padding="8,4" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="* 提示：优先使用大模型翻译；若仅配置了密钥或遇到 52003 未授权，系统会自动无缝回退至通用翻译 (MD5 签名) 确保可用。"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Expander>

                        <!-- 2. 谷歌翻译 API 配置 -->
                        <Expander Header="谷歌翻译 API (Cloud Translation API NMT，每月默认 50 万字符)" IsExpanded="False" Padding="8,6">
                            <StackPanel Spacing="10" Margin="0,4,0,0">
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="Google API Key:" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding GoogleApiKey}" PasswordChar="*" FontSize="12" PlaceholderText="Google Cloud API 密钥" />
                                </Grid>
                                <Grid ColumnDefinitions="140,*,Auto">
                                    <TextBlock Grid.Column="0" Text="每月字符上限:" VerticalAlignment="Center" FontSize="12" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding GoogleMonthlyLimit}" Minimum="0" Maximum="10000000" Increment="50000" FormatString="N0" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GoogleUsedCount, StringFormat='当月已用: {0:N0} 字符'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Button Content="重置计数" Command="{Binding ResetGoogleUsedCountCommand}" Padding="8,4" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- 3. AI 接口自定义翻译提示词配置 -->
                        <Expander Header="AI 接口翻译提示词 (适用于从「统一 AI 接口池」选取的各 AI 节点)" IsExpanded="False" Padding="8,6">
                            <StackPanel Spacing="10" Margin="0,4,0,0">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="翻译提示词模板" FontSize="12" />
                                        <Button Grid.Column="1"
                                                Content="恢复默认"
                                                Command="{Binding ResetAiTranslatePromptCommand}"
                                                Padding="8,2"
                                                FontSize="11"
                                                Classes="subtle" />
                                    </Grid>
                                    <TextBox Text="{Binding AiTranslatePromptText}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="96"
                                             MaxHeight="160"
                                             FontSize="12"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="支持宏变量：{TargetLanguage}（目标语言名称）、{SourceLanguage}（源语言名称）。可自定义口吻、专业术语约束或格式要求。"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- 4. 火山引擎翻译 API 配置 -->
                        <Expander Header="火山引擎翻译 API (支持自然语言、小说等多领域，HMAC-SHA256 V4 鉴权，每月默认 200 万字符)" IsExpanded="False" Padding="8,6">
                            <StackPanel Spacing="10" Margin="0,4,0,0">
                                <Grid ColumnDefinitions="140,*,140,*">
                                    <TextBlock Grid.Column="0" Text="AccessKey (AK):" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding VolcengineAccessKey}" Margin="0,0,12,0" FontSize="12" PlaceholderText="火山引擎 AccessKey" />
                                    <TextBlock Grid.Column="2" Text="SecretKey (SK):" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="3" Text="{Binding VolcengineSecretKey}" PasswordChar="*" FontSize="12" PlaceholderText="火山引擎 SecretKey" />
                                </Grid>
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="服务地域 (Region):" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding VolcengineRegion}" FontSize="12" PlaceholderText="cn-north-1 (华北1)" />
                                </Grid>
                                <Grid ColumnDefinitions="140,*,Auto">
                                    <TextBlock Grid.Column="0" Text="每月字符上限:" VerticalAlignment="Center" FontSize="12" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding VolcengineMonthlyLimit}" Minimum="0" Maximum="10000000" Increment="50000" FormatString="N0" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VolcengineUsedCount, StringFormat='当月已用: {0:N0} 字符'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Button Content="重置计数" Command="{Binding ResetVolcengineUsedCountCommand}" Padding="8,4" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- 5. 阿里云机器翻译 API 配置 -->
                        <Expander Header="阿里云机器翻译 API (通用版/电商版，ROA 签名鉴权，每月默认 100 万字符)" IsExpanded="False" Padding="8,6">
                            <StackPanel Spacing="10" Margin="0,4,0,0">
                                <Grid ColumnDefinitions="140,*,140,*">
                                    <TextBlock Grid.Column="0" Text="AccessKey ID:" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding AliyunAccessKeyId}" Margin="0,0,12,0" FontSize="12" PlaceholderText="阿里云 AccessKeyId" />
                                    <TextBlock Grid.Column="2" Text="AccessKey Secret:" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="3" Text="{Binding AliyunAccessKeySecret}" PasswordChar="*" FontSize="12" PlaceholderText="阿里云 AccessKeySecret" />
                                </Grid>
                                <Grid ColumnDefinitions="140,*">
                                    <TextBlock Grid.Column="0" Text="服务接入地址:" VerticalAlignment="Center" FontSize="12" />
                                    <TextBox Grid.Column="1" Text="{Binding AliyunApiEndpoint}" FontSize="12" PlaceholderText="http://mt.cn-hangzhou.aliyuncs.com/api/translate/web/general" />
                                </Grid>
                                <Grid ColumnDefinitions="140,*,Auto">
                                    <TextBlock Grid.Column="0" Text="每月字符上限:" VerticalAlignment="Center" FontSize="12" />
                                    <NumericUpDown Grid.Column="1" Value="{Binding AliyunMonthlyLimit}" Minimum="0" Maximum="10000000" Increment="50000" FormatString="N0" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AliyunUsedCount, StringFormat='当月已用: {0:N0} 字符'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Button Content="重置计数" Command="{Binding ResetAliyunUsedCountCommand}" Padding="8,4" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- 配置文件与日志服务 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="配置文件与日志服务" FontWeight="SemiBold" FontSize="15" />

                        <!-- 软件数据根目录 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="软件数据根目录 (%LocalAppData%\ShawMuOCR)" FontWeight="Medium" />
                                <TextBox Text="{Binding AppDataDirectory}"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         Margin="0,6,0,0"
                                         VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="打开目录"
                                        Command="{Binding OpenAppDataFolderCommand}"
                                        Padding="10,5" />
                                <Button Content="复制路径"
                                        Command="{Binding CopyAppDataPathCommand}"
                                        Padding="10,5" />
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 配置文件路径展示 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="配置文件路径 (settings.json)" FontWeight="Medium" />
                                <TextBox Text="{Binding SettingsFilePath}"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         Margin="0,6,0,0"
                                         VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="打开文件"
                                        Command="{Binding OpenSettingsFileCommand}"
                                        Padding="10,5" />
                                <Button Content="打开所在目录"
                                        Command="{Binding OpenSettingsFolderCommand}"
                                        Padding="10,5" />
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 日志记录服务 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <CheckBox Content="开启本地运行日志记录（遇到异常或错误自动写入日志）"
                                          IsChecked="{Binding EnableLogging}"
                                          FontWeight="Medium" />
                                <TextBox Text="{Binding LogDirectory}"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         Margin="0,6,0,0"
                                         VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="打开日志目录"
                                    Command="{Binding OpenLogFolderCommand}"
                                    Padding="10,5"
                                    VerticalAlignment="Bottom" />
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 日志定期自动清理 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="日志定期自动清理" FontWeight="Medium" />
                                <TextBlock Text="定时扫描并自动清理超过保留期限的历史日志文件，避免长期运行无节制占用磁盘空间"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <CheckBox Content="启用" IsChecked="{Binding EnableLogAutoClean}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding AvailableLogRetentionDays}"
                                          SelectedItem="{Binding LogRetentionDays}"
                                          IsEnabled="{Binding EnableLogAutoClean}"
                                          Width="80" />
                                <TextBlock Text="天" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Content="立即清理"
                                        Command="{Binding CleanExpiredLogsCommand}"
                                        Padding="10,5"
                                        ToolTip.Tip="根据当前保留天数立即扫描并清理过期历史日志" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- 恢复默认设置确认弹窗遮罩 -->
    <Border Background="#60000000"
            IsVisible="{Binding IsResetConfirmOpen}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="22,18"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 24 #30000000">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="↺" FontSize="18" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center" />
                    <TextBlock Text="确认恢复默认设置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="确定要将所有设置还原为初始默认值吗？快捷键、识别模型、界面主题、调度配置等将恢复为出厂状态。"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <!-- 询问是否清除 API 信息 -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <CheckBox IsChecked="{Binding ResetClearApiCredentials}"
                                  Content="同时清除 API 密钥与凭据配置"
                                  FontWeight="Medium"
                                  FontSize="12" />
                        <TextBlock Text="勾选将一并清空百度、谷歌、OpenAI 等翻译 API Key 与 Token；默认不勾选以保留您的密钥资产。"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="28,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- 操作按钮 -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                    <Button Grid.Column="1"
                            Content="取消"
                            Command="{Binding CancelResetConfirmDialogCommand}"
                            Padding="14,6"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Content="确认恢复"
                            Command="{Binding ConfirmResetDefaultsCommand}"
                            Classes="accent"
                            Padding="14,6" />
                </Grid>
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</UserControl>
