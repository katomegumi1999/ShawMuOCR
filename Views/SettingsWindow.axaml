<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShawMuOCR.ViewModels"
        xmlns:services="using:ShawMuOCR.Services"
        x:Class="ShawMuOCR.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置 - 小沐 OCR"
        Width="580" Height="660"
        MinWidth="540" MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/logo.ico">

    <Panel>
    <Grid RowDefinitions="Auto,*" Margin="24">
        <!-- 顶部操作栏 (Topbar) -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="14,10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                        Content="↺ 恢复默认设置"
                        Command="{Binding ShowResetConfirmDialogCommand}"
                        Classes="subtle"
                        Padding="10,6"
                        FontSize="12"
                        ToolTip.Tip="将所有设置项还原为出厂默认设置" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0,16,0">
                    <TextBlock Text="💡" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding !IsRecordingAnyHotkey}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               IsVisible="{Binding !IsRecordingAnyHotkey}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="保存"
                        Command="{Binding SaveCommand}"
                        Classes="accent"
                        Width="80"
                        Margin="0,0,8,0" />

                <Button Grid.Column="3"
                        Content="取消"
                        Command="{Binding CancelCommand}"
                        Width="80" />
            </Grid>
        </Border>

        <!-- 内容区域 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">
                <!-- 常规设置 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="常规与快捷键设置" FontWeight="SemiBold" FontSize="15" />

                        <!-- 快捷键录制提示条（录制中高亮显示，全宽包裹防挤压） -->
                        <Border Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                BorderBrush="{DynamicResource AccentStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                IsVisible="{Binding IsRecordingAnyHotkey}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="⌨" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StatusMessage}"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Content="取消 (Esc)"
                                        Command="{Binding CancelRecordingCommand}"
                                        Padding="8,4"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 快捷键 1: 截图 OCR -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="截图 OCR 全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="唤起全屏框选截屏并执行文字识别"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding Hotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                        Command="{Binding StartRecordHotkeyCommand}"
                                        Padding="10,5" />
                                <Button Content="✕"
                                        ToolTip.Tip="清空此快捷键(禁用)"
                                        Command="{Binding ClearHotkeyCommand}"
                                        Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 2: 截图复制 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="截图复制全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="框选后直接将截取的图像写入系统剪贴板"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding CaptureImageHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                        Command="{Binding StartRecordCaptureImageHotkeyCommand}"
                                        Padding="10,5" />
                                <Button Content="✕"
                                        ToolTip.Tip="清空此快捷键(禁用)"
                                        Command="{Binding ClearCaptureImageHotkeyCommand}"
                                        Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 3: 截图标注 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="截图标注全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="框选后打开画图编辑器（支持画线、箭头、矩形、文字与置顶贴图）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding AnnotateHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                        Command="{Binding StartRecordAnnotateHotkeyCommand}"
                                        Padding="10,5" />
                                <Button Content="✕"
                                        ToolTip.Tip="清空此快捷键(禁用)"
                                        Command="{Binding ClearAnnotateHotkeyCommand}"
                                        Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 4: 长截屏 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="长截屏全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="框选区域后滚动窗口连续拼接长图并自动复制到剪贴板（默认 Alt+L）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding LongScreenshotHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                        Command="{Binding StartRecordLongScreenshotHotkeyCommand}"
                                        Padding="10,5" />
                                <Button Content="✕"
                                        ToolTip.Tip="清空此快捷键(禁用)"
                                        Command="{Binding ClearLongScreenshotHotkeyCommand}"
                                        Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <!-- 快捷键 5: 屏幕录制 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="屏幕录制全局快捷键" FontWeight="Medium" />
                                <TextBlock Text="唤起录屏桌面悬浮控制条或框选区域开始录制（默认 Alt+R）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding RecordingHotkey}"
                                         IsReadOnly="True"
                                         Width="120"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Button Content="录制"
                                        Command="{Binding StartRecordRecordingHotkeyCommand}"
                                        Padding="10,5" />
                                <Button Content="✕"
                                        ToolTip.Tip="清空此快捷键(禁用)"
                                        Command="{Binding ClearRecordingHotkeyCommand}"
                                        Padding="8,5" />
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 行为开关 -->
                        <CheckBox Content="OCR 识别完成后自动复制文本到剪贴板"
                                  IsChecked="{Binding AutoCopy}" />

                        <CheckBox Content="表格智能分列（识别到表格时，粘贴到 Excel / WPS 自动落入单元格）"
                                  IsChecked="{Binding AutoCopyTableAsCells}"
                                  IsEnabled="{Binding AutoCopy}"
                                  Margin="26,0,0,0"
                                  ToolTip.Tip="开启后，若识别结果呈表格结构（多行多列、各列按检测框垂直对齐），剪贴板会同时写入 HTML 表格与纯文本两种格式：粘贴到 Excel / WPS / Word 时还原为真正的单元格（空单元格留空、合并表头保留跨列、列不错位），粘贴到聊天窗口、记事本、搜索框时只得到干净的纯文本，不会出现制表符空档。关闭则一律使用原有空格分隔文本。" />

                        <CheckBox Content="静默模式（识别完成后不弹出主界面）"
                                  IsChecked="{Binding SilentMode}" />

                        <CheckBox Content="静默启动（启动后直接最小化至系统托盘，不显示主界面）"
                                  IsChecked="{Binding SilentStartup}" />

                        <CheckBox Content="OCR 识别气泡提醒（在屏幕底部弹出文字摘要与耗时统计）"
                                  IsChecked="{Binding ShowOcrNotification}" />

                        <CheckBox Content="截图复制气泡提醒（在屏幕底部弹出截图复制成功提示）"
                                  IsChecked="{Binding ShowCaptureImageNotification}" />

                        <CheckBox Content="开机自启动"
                                  IsChecked="{Binding StartWithWindows}" />
                    </StackPanel>
                </Border>

                <!-- OCR 模型设置 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="OCR 引擎与模型设置" FontWeight="SemiBold" FontSize="15" />

                        <!-- 模型选择：直接读取同目录下的 models 文件夹 -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="OCR 推理模型" FontWeight="Medium" />
                                    <TextBlock Text="{Binding ModelSelectionHint}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding AvailableModels}"
                                              SelectedItem="{Binding SelectedModel}"
                                              IsEnabled="{Binding HasAvailableModels}"
                                              PlaceholderText="未检测到可用模型"
                                              MinWidth="180" />
                                    <Button Content="🔄"
                                            ToolTip.Tip="重新扫描 models 目录"
                                            Command="{Binding RefreshModelsCommand}"
                                            Padding="8,5" />
                                    <Button Content="📂"
                                            ToolTip.Tip="打开 models 文件夹"
                                            Command="{Binding OpenModelsFolderCommand}"
                                            Padding="8,5" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 未检测到任何模型时的醒目提醒 -->
                        <Border Background="#26D83B01"
                                BorderBrush="#80D83B01"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                IsVisible="{Binding HasNoModels}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="⚠️" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="未检测到任何 OCR 模型文件" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="本程序默认不内置模型，请将随程序分发的 models 文件夹放置在与主程序同一目录下，然后点击“🔄”重新扫描。"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="打开目录"
                                        Command="{Binding OpenModelsFolderCommand}"
                                        Padding="8,4"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 推理加速后端 (Auto / GPU Vulkan / CPU SIMD) -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="推理加速后端 (GPU / CPU)" FontWeight="Medium" />
                                <TextBlock Text="{Binding OcrBackendHint}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableOcrBackends}"
                                      SelectedItem="{Binding SelectedOcrBackendOption}"
                                      services:ComboBoxHelper.DisableWheelChange="True"
                                      MinWidth="180"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Auto 模式下实时回报当前自动选中的模式 -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="12,8"
                                IsVisible="{Binding IsAutoBackendSelected}">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="当前自动选择模式："
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AutoResolvedBackendText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding AutoResolvedReasonText, StringFormat='判定依据：{0}'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 物理显卡手动选择 (独显 / 核显) -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowGpuDeviceSelector}">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="选择物理显卡 (GPU 设备)" FontWeight="Medium" />
                                <TextBlock Text="支持在独立显卡 ([独显]) 与集成显卡 ([核显]) 之间手动指定，默认优先使用独立显卡"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableGpuDevices}"
                                      SelectedItem="{Binding SelectedGpuDeviceOption}"
                                      services:ComboBoxHelper.DisableWheelChange="True"
                                      MinWidth="240"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 最大检测边长 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="文本检测最大长边限制" FontWeight="Medium" />
                                <TextBlock Text="超限将等比缩放送检，字符识别仍用高清原图（推荐 1280）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableMaxSideLens}"
                                      SelectedItem="{Binding MaxSideLen}"
                                      Width="160" />
                        </Grid>

                        <!-- 文字方向检测开关 -->
                        <CheckBox Content="开启文字方向角度检测（识别倒立文字；关闭可节省约 150MB 内存）"
                                  IsChecked="{Binding EnableAngleDetection}" />

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 闲置自动休眠 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="闲置自动休眠释放内存" FontWeight="Medium" />
                                <TextBlock Text="无截屏操作达到指定时长时，自动深度释放物理内存池"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <CheckBox Content="启用" IsChecked="{Binding EnableIdleSleep}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding AvailableIdleSleepMinutes}"
                                          SelectedItem="{Binding IdleSleepMinutes}"
                                          IsEnabled="{Binding EnableIdleSleep}"
                                          Width="90" />
                                <TextBlock Text="分钟" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 配置文件与日志服务 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="配置文件与日志服务" FontWeight="SemiBold" FontSize="15" />

                        <!-- 软件数据根目录 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="软件数据根目录 (%LocalAppData%\ShawMuOCR)" FontWeight="Medium" />
                                <TextBox Text="{Binding AppDataDirectory}"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         Margin="0,6,0,0"
                                         VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="打开目录"
                                        Command="{Binding OpenAppDataFolderCommand}"
                                        Padding="10,5" />
                                <Button Content="复制路径"
                                        Command="{Binding CopyAppDataPathCommand}"
                                        Padding="10,5" />
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 配置文件路径展示 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="配置文件路径 (settings.json)" FontWeight="Medium" />
                                <TextBox Text="{Binding SettingsFilePath}"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         Margin="0,6,0,0"
                                         VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Content="打开文件"
                                        Command="{Binding OpenSettingsFileCommand}"
                                        Padding="10,5" />
                                <Button Content="打开所在目录"
                                        Command="{Binding OpenSettingsFolderCommand}"
                                        Padding="10,5" />
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 日志记录服务 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <CheckBox Content="开启本地运行日志记录（遇到异常或错误自动写入日志）"
                                          IsChecked="{Binding EnableLogging}"
                                          FontWeight="Medium" />
                                <TextBox Text="{Binding LogDirectory}"
                                         IsReadOnly="True"
                                         FontSize="12"
                                         Margin="0,6,0,0"
                                         VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="打开日志目录"
                                    Command="{Binding OpenLogFolderCommand}"
                                    Padding="10,5"
                                    VerticalAlignment="Bottom" />
                        </Grid>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                        <!-- 日志定期自动清理 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="日志定期自动清理" FontWeight="Medium" />
                                <TextBlock Text="定时扫描并自动清理超过保留期限的历史日志文件，避免长期运行无节制占用磁盘空间"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <CheckBox Content="启用" IsChecked="{Binding EnableLogAutoClean}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding AvailableLogRetentionDays}"
                                          SelectedItem="{Binding LogRetentionDays}"
                                          IsEnabled="{Binding EnableLogAutoClean}"
                                          Width="80" />
                                <TextBlock Text="天" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Content="立即清理"
                                        Command="{Binding CleanExpiredLogsCommand}"
                                        Padding="10,5"
                                        ToolTip.Tip="根据当前保留天数立即扫描并清理过期历史日志" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 关于与系统诊断 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                            <TextBlock Text="关于与模型内存检测" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="实时查看 OCR 引擎状态、物理工作集/专用内存与一键深度释放"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="打开内存检测"
                                Command="{Binding OpenAboutCommand}"
                                Padding="12,6"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- 恢复默认设置确认弹窗遮罩 -->
    <Border Background="#60000000"
            IsVisible="{Binding IsResetConfirmOpen}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="22,18"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 24 #30000000">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="↺" FontSize="18" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center" />
                    <TextBlock Text="确认恢复默认设置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="确定要将所有设置还原为初始默认值吗？快捷键、识别模型、界面主题、调度配置等将恢复为出厂状态。"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <!-- 询问是否清除 API 信息 -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10">
                    <StackPanel Spacing="4">
                        <CheckBox IsChecked="{Binding ResetClearApiCredentials}"
                                  Content="同时清除 API 密钥与凭据配置"
                                  FontWeight="Medium"
                                  FontSize="12" />
                        <TextBlock Text="勾选将一并清空百度、谷歌、OpenAI 等翻译 API Key 与 Token；默认不勾选以保留您的密钥资产。"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="28,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- 操作按钮 -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                    <Button Grid.Column="1"
                            Content="取消"
                            Command="{Binding CancelResetConfirmDialogCommand}"
                            Padding="14,6"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Content="确认恢复"
                            Command="{Binding ConfirmResetDefaultsCommand}"
                            Classes="accent"
                            Padding="14,6" />
                </Grid>
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</Window>
