<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShawMuOCR.ViewModels"
             x:Class="ShawMuOCR.Views.Components.ImageDocumentPreviewControl"
             x:DataType="vm:MainViewModel"
             x:Name="RootPreviewControl"
             DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 顶部操作条（支持可选显示） -->
        <Border Grid.Row="0" Padding="12,6"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                IsVisible="{Binding #RootPreviewControl.ShowTopBar}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="🔄 旋转 90°"
                            Command="{Binding #RootPreviewControl.RotateCommand}"
                            IsVisible="{Binding #RootPreviewControl.Source, Converter={x:Static ObjectConverters.IsNotNull}}"
                            FontSize="11"
                            Padding="8,3"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            ToolTip.Tip="将当前图片顺时针旋转 90°" />
                    <Button Content="💾 保存图片"
                            Command="{Binding #RootPreviewControl.SaveCommand}"
                            IsVisible="{Binding #RootPreviewControl.Source, Converter={x:Static ObjectConverters.IsNotNull}}"
                            FontSize="11"
                            Padding="8,3"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            ToolTip.Tip="将当前图片另存为文件" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding #RootPreviewControl.HeaderTitle}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 标注工具条 (仅在开启标注且有图片时显示) -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                IsVisible="{Binding #RootPreviewControl.IsAnnotationToolbarVisible}">
            <DockPanel LastChildFill="True">
                <!-- 右侧：粗细与预设颜色 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- 粗细选择 -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <RadioButton Name="StrokeThinRadio" Classes="subtle" GroupName="PreviewStrokeGroup" Content="细" FontSize="11" Click="OnStrokeRadioClick" Tag="2" />
                        <RadioButton Name="StrokeMediumRadio" Classes="subtle" GroupName="PreviewStrokeGroup" Content="中" FontSize="11" IsChecked="True" Click="OnStrokeRadioClick" Tag="4" />
                        <RadioButton Name="StrokeThickRadio" Classes="subtle" GroupName="PreviewStrokeGroup" Content="粗" FontSize="11" Click="OnStrokeRadioClick" Tag="8" />
                    </StackPanel>

                    <Separator Width="1" Height="14" Margin="2,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- 颜色圆点 -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <RadioButton Name="ColorRedRadio" Width="18" Height="18" CornerRadius="9" Background="#E53935" GroupName="PreviewColorGroup" IsChecked="True" Click="OnColorRadioClick" Tag="#E53935" ToolTip.Tip="红色" />
                        <RadioButton Name="ColorGreenRadio" Width="18" Height="18" CornerRadius="9" Background="#43A047" GroupName="PreviewColorGroup" Click="OnColorRadioClick" Tag="#43A047" ToolTip.Tip="绿色" />
                        <RadioButton Name="ColorBlueRadio" Width="18" Height="18" CornerRadius="9" Background="#1E88E5" GroupName="PreviewColorGroup" Click="OnColorRadioClick" Tag="#1E88E5" ToolTip.Tip="蓝色" />
                        <RadioButton Name="ColorYellowRadio" Width="18" Height="18" CornerRadius="9" Background="#FDD835" GroupName="PreviewColorGroup" Click="OnColorRadioClick" Tag="#FDD835" ToolTip.Tip="黄色" />
                        <RadioButton Name="ColorBlackRadio" Width="18" Height="18" CornerRadius="9" Background="#000000" GroupName="PreviewColorGroup" Click="OnColorRadioClick" Tag="#000000" ToolTip.Tip="黑色" />
                        <RadioButton Name="ColorWhiteRadio" Width="18" Height="18" CornerRadius="9" Background="#FFFFFF" BorderBrush="#888888" BorderThickness="1" GroupName="PreviewColorGroup" Click="OnColorRadioClick" Tag="#FFFFFF" ToolTip.Tip="白色" />
                    </StackPanel>
                </StackPanel>

                <!-- 左侧：图元工具切换 + 撤销/清空 -->
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <RadioButton Name="ToolSelectRadio" Classes="subtle" GroupName="PreviewToolGroup" IsChecked="True" Click="OnToolRadioClick" Tag="Select" ToolTip.Tip="浏览/选择 (无标注手势，支持自由平移缩放)">
                        <TextBlock Text="👆 浏览" FontSize="11" />
                    </RadioButton>
                    <RadioButton Name="ToolRectRadio" Classes="subtle" GroupName="PreviewToolGroup" Click="OnToolRadioClick" Tag="Rect" ToolTip.Tip="矩形框选 (R)">
                        <TextBlock Text="🔲 矩形" FontSize="11" />
                    </RadioButton>
                    <RadioButton Name="ToolEllipseRadio" Classes="subtle" GroupName="PreviewToolGroup" Click="OnToolRadioClick" Tag="Ellipse" ToolTip.Tip="圆形/椭圆 (O)">
                        <TextBlock Text="⭕ 椭圆" FontSize="11" />
                    </RadioButton>
                    <RadioButton Name="ToolArrowRadio" Classes="subtle" GroupName="PreviewToolGroup" Click="OnToolRadioClick" Tag="Arrow" ToolTip.Tip="箭头 (A)">
                        <TextBlock Text="➡️ 箭头" FontSize="11" />
                    </RadioButton>
                    <RadioButton Name="ToolLineRadio" Classes="subtle" GroupName="PreviewToolGroup" Click="OnToolRadioClick" Tag="Line" ToolTip.Tip="直线 (L)">
                        <TextBlock Text="📏 直线" FontSize="11" />
                    </RadioButton>
                    <RadioButton Name="ToolPenRadio" Classes="subtle" GroupName="PreviewToolGroup" Click="OnToolRadioClick" Tag="Pen" ToolTip.Tip="画笔涂鸦 (P)">
                        <TextBlock Text="✏️ 画笔" FontSize="11" />
                    </RadioButton>
                    <RadioButton Name="ToolMosaicRadio" Classes="subtle" GroupName="PreviewToolGroup" Click="OnToolRadioClick" Tag="Mosaic" ToolTip.Tip="马赛克遮蔽 (M)">
                        <TextBlock Text="🔲 马赛克" FontSize="11" />
                    </RadioButton>
                    <RadioButton Name="ToolTextRadio" Classes="subtle" GroupName="PreviewToolGroup" Click="OnToolRadioClick" Tag="Text" ToolTip.Tip="文字标注 (T)">
                        <TextBlock Text="🔤 文字" FontSize="11" />
                    </RadioButton>

                    <Separator Width="1" Height="14" Margin="3,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- 撤销 -->
                    <Button Name="UndoBtn" Classes="subtle" Padding="6,3" Click="OnUndoClick" ToolTip.Tip="撤销上一步标注 (Ctrl+Z)">
                        <TextBlock Text="↶ 撤销" FontSize="11" />
                    </Button>

                    <!-- 清空标注 -->
                    <Button Name="ClearBtn" Classes="subtle" Padding="6,3" Click="OnClearAnnotationsClick" ToolTip.Tip="清空所有标注">
                        <TextBlock Text="↺ 清空" FontSize="11" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 图片展示或空白引导 -->
        <Grid Grid.Row="2">
            <!-- 占位引导与拖拽投递区 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="16"
                        IsVisible="{Binding #RootPreviewControl.Source, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock Text="📄" FontSize="42" HorizontalAlignment="Center" Opacity="0.35" />
                <TextBlock Text="暂无预览内容"
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            FontSize="15"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="按快捷键快速截屏，或拖拽图片/PDF到此处"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- 快捷提示卡片 -->
                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="14,10" Margin="0,4,0,0">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="✂" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding CurrentHotkey, StringFormat='快捷键 {0} 立即截屏'}"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        IsVisible="{Binding HasHotkey, FallbackValue=False}" />
                        </StackPanel>
                        <TextBlock Text="📁 支持 PNG, JPG, BMP, WEBP, TIFF 及多页 PDF"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 真实图片交互式无级平移与滚轮缩放视口 -->
            <Panel x:Name="ImageViewportPanel"
                   Background="Transparent"
                   ClipToBounds="True"
                   Cursor="Hand"
                   IsVisible="{Binding #RootPreviewControl.Source, Converter={x:Static ObjectConverters.IsNotNull}}"
                   PointerWheelChanged="OnImageViewportPointerWheelChanged"
                   PointerPressed="OnImageViewportPointerPressed"
                   PointerMoved="OnImageViewportPointerMoved"
                   PointerReleased="OnImageViewportPointerReleased">
                <!-- 图片渲染容器 -->
                <Canvas x:Name="ImageContainerCanvas"
                        ClipToBounds="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                            <TranslateTransform X="0" Y="0" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Image x:Name="PreviewImageControl"
                           Source="{Binding #RootPreviewControl.Source}"
                           Stretch="Fill"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />

                    <!-- 标注交互绘制层 (覆盖在图像正上方) -->
                    <Canvas x:Name="DrawingOverlayCanvas"
                            Background="Transparent"
                            ClipToBounds="False"
                            PointerPressed="OnDrawingCanvasPointerPressed"
                            PointerMoved="OnDrawingCanvasPointerMoved"
                            PointerReleased="OnDrawingCanvasPointerReleased" />

                    <!-- 内联透明文字输入框 -->
                    <TextBox x:Name="InlineTextBox"
                             IsVisible="False"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Background="#CC000000"
                             Foreground="#FFFFFF"
                             BorderBrush="#CC40A9FF"
                             BorderThickness="1"
                             CornerRadius="3"
                             Padding="3,2"
                             MinWidth="40"
                             MinHeight="26"
                             ZIndex="999"
                             LostFocus="OnInlineTextBoxLostFocus"
                             KeyDown="OnInlineTextBoxKeyDown" />
                </Canvas>

                <!-- 底部悬浮快捷控制与缩放胶囊 -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="12"
                        Background="#CC1E1E1E"
                        BorderBrush="#35FFFFFF"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="6,3"
                        BoxShadow="0 4 12 0 #40000000">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <!-- 缩小 -->
                        <Button Classes="subtle"
                                Padding="6,3"
                                CornerRadius="12"
                                ToolTip.Tip="缩小 (也可向下滚动滚轮)"
                                Click="OnZoomOutClick">
                            <TextBlock Text="➖" FontSize="11" Foreground="#CCCCCC" />
                        </Button>

                        <!-- 缩放比例文字 (点击可重置为 100%) -->
                        <Button Classes="subtle"
                                Padding="6,3"
                                CornerRadius="4"
                                ToolTip.Tip="点击重置为 100% 原始尺寸"
                                Click="OnResetActualSizeClick">
                            <TextBlock x:Name="ZoomPercentTextBlock"
                                       Text="100%"
                                       FontSize="11"
                                       Foreground="#E0E0E0"
                                       FontWeight="Medium" />
                        </Button>

                        <!-- 放大 -->
                        <Button Classes="subtle"
                                Padding="6,3"
                                CornerRadius="12"
                                ToolTip.Tip="放大 (也可向上滚动滚轮)"
                                Click="OnZoomInClick">
                            <TextBlock Text="➕" FontSize="11" Foreground="#CCCCCC" />
                        </Button>

                        <!-- 分割小细线 -->
                        <Separator Width="1" Height="14" Margin="2,0" Background="#35FFFFFF" />

                        <!-- 自适应全图 -->
                        <Button Classes="subtle"
                                Padding="6,3"
                                CornerRadius="12"
                                ToolTip.Tip="适应窗口 (双击画布也可重置自适应)"
                                Click="OnResetFitClick">
                            <TextBlock Text="🔲" FontSize="11" Foreground="#CCCCCC" />
                        </Button>
                    </StackPanel>
                </Border>
            </Panel>
        </Grid>
    </Grid>
</UserControl>
