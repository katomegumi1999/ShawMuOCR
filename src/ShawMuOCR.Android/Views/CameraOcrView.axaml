<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ShawMuOCR.Android.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="ShawMuOCR.Android.Views.CameraOcrView"
             x:DataType="vm:CameraOcrViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- 拍照启动大按钮 -->
        <Border Grid.Row="0" Margin="12,12,12,6" Padding="14" CornerRadius="10" Background="{DynamicResource SystemChromeLowColor}">
            <Button Command="{Binding TakePhotoAndRecognizeCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="14"
                    Classes="accent">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="📷" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="立即拍照识别文字" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <!-- 状态指示 -->
        <Border Grid.Row="1" Margin="12,2,12,6" Padding="10,6" CornerRadius="6" Background="{DynamicResource SystemChromeMediumColor}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ExecutionTimeInfo}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- 内容区域：拍摄图像与输出结果 -->
        <Grid Grid.Row="2" RowDefinitions="*,*" Margin="12,4">
            <!-- 拍摄照片预览 -->
            <Border Grid.Row="0" Margin="0,0,0,4" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SystemChromeLowColor}">
                <Image Source="{Binding CapturedPreview}" Stretch="Uniform" />
            </Border>

            <!-- 识别文本输出 -->
            <Border Grid.Row="1" Margin="0,4,0,0" CornerRadius="8" Padding="8" Background="{DynamicResource SystemChromeLowColor}">
                <TextBox Text="{Binding RecognizedText}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsReadOnly="False"
                         PlaceholderText="拍照完成后的 OCR 文字将在此显示，可直接编辑修改..."
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- 底部快捷工具栏 -->
        <Border Grid.Row="3" Margin="12,4,12,12" Padding="8">
            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" Command="{Binding CopyTextCommand}"
                        Content="📋 复制全部文字"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,6,0"
                        Padding="10" />
                <Button Grid.Column="1" Command="{Binding ClearTextCommand}"
                        Content="🗑️ 清空结果"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="6,0,0,0"
                        Padding="10" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
