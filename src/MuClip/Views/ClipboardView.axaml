<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MuClip.ViewModels"
             xmlns:models="using:MuClip.Models"
             x:Class="MuClip.Views.ClipboardView"
             x:Name="Root"
             x:DataType="vm:ClipboardViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部操作栏 (剪贴板主页面) -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="12,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding !IsFileTransferViewActive}">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <!-- 左侧：搜索框与分类过滤 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- 搜索框 -->
                    <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="🔍 搜索剪贴板历史..."
                             Width="220"
                             VerticalAlignment="Center" />

                    <!-- 类型过滤选择器 -->
                    <ComboBox ItemsSource="{Binding TypeFilters}"
                              SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}"
                              Width="100"
                              VerticalAlignment="Center" />

                    <!-- 状态信息 -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="260" />
                </StackPanel>

                <!-- 右侧：同步开关、文件传输、清空、刷新按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 文件传输二级页面呼出按钮 -->
                    <Button Command="{Binding OpenFileTransferViewCommand}"
                            Padding="10,5"
                            ToolTip.Tip="打开局域网高速加密文件传输页面 (100MB/s+)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🚀" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="文件传输" FontSize="12" VerticalAlignment="Center" />
                            <Border Background="#10B981"
                                    CornerRadius="8" Padding="5,1" VerticalAlignment="Center"
                                    IsVisible="{Binding ActiveTransferCount}">
                                <TextBlock Text="{Binding ActiveTransferCount}" FontSize="10" Foreground="White" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ToggleSyncPanelCommand}"
                            Padding="10,5"
                            ToolTip.Tip="查看局域网多端自发现与配对状态">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="📡" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="局域网同步" FontSize="12" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="5,1" VerticalAlignment="Center"
                                    IsVisible="{Binding OnlinePeerCount}">
                                <TextBlock Text="{Binding OnlinePeerCount}" FontSize="10" Foreground="White" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- 快捷面板底色调色盘 -->
                    <Button Padding="8,5"
                            ToolTip.Tip="自定义快捷面板背景底色">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="10" Width="230" Margin="4">
                                    <TextBlock Text="🎨 快捷面板底色" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="设置 Ctrl+~ 呼出的悬浮快捷面板背景色："
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <!-- 预设调色盘色块 -->
                                    <ItemsControl ItemsSource="{Binding PaletteColors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PaletteColorItem">
                                                <Button Width="26" Height="26" Margin="3" Padding="0" CornerRadius="13"
                                                        BorderBrush="#40808080" BorderThickness="1.5"
                                                        Background="{Binding Brush}"
                                                        Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).SelectPaletteColorCommand}"
                                                        CommandParameter="{Binding Hex}"
                                                        ToolTip.Tip="{Binding Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 自定义 Hex 输入 -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <TextBox Text="{Binding PanelBackgroundColor, Mode=TwoWay}"
                                                 PlaceholderText="#F4F4F6"
                                                 FontSize="12"
                                                 Padding="6,4" />
                                        <Button Grid.Column="1" Content="应用" Margin="6,0,0,0" Padding="10,4"
                                                Command="{Binding ApplyPanelBackgroundCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Border Width="11" Height="11" CornerRadius="5.5"
                                    Background="{Binding CurrentPanelBackgroundBrush}"
                                    BorderBrush="#808080" BorderThickness="1"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="面板底色" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Padding="8,5"
                            ToolTip.Tip="从 Rust 内存池热缓存刷新">
                        <TextBlock Text="🔄 刷新" FontSize="12" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding ClearAllCommand}"
                            Padding="8,5"
                            ToolTip.Tip="清空所有记录">
                        <TextBlock Text="🗑 清空" FontSize="12" Foreground="#EF4444" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 顶部操作栏 (文件传输二级页面) -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="12,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding IsFileTransferViewActive}">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- 返回按钮与页面标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Command="{Binding CloseFileTransferViewCommand}"
                            Padding="10,5" Classes="accent"
                            ToolTip.Tip="返回剪贴板主页面">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="←" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="返回剪贴板" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Separator Width="1" Height="18" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="2,0" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="局域网高速加密文件传输" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" Margin="4,0,0,0">
                            <TextBlock Text="128KB 切片 · XChaCha20 · 100MB/s+" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 中间：状态提示 -->
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12" Margin="16,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- 右侧：下载保存目录与操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding FileSaveDirectory, StringFormat='当前接收目录: {0}'}">
                        <TextBlock Text="接收目录:" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileSaveDirectory}" FontSize="11" FontWeight="Medium" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Command="{Binding BrowseSaveDirectoryCommand}" Padding="8,4" ToolTip.Tip="更改文件接收保存目录">
                        <TextBlock Text="更改" FontSize="11" />
                    </Button>
                    <Button Command="{Binding OpenSaveDirectoryCommand}" Padding="8,4" ToolTip.Tip="在资源管理器中打开保存文件夹">
                        <TextBlock Text="📂 打开目录" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区：左侧历史/常用语列表 + 右侧详情/编辑 + 右侧抽屉同步面板 -->
        <Grid Grid.Row="1" ColumnDefinitions="320,*,Auto" IsVisible="{Binding !IsFileTransferViewActive}">
            <!-- 左侧：剪贴历史 / 常用语 切换与列表 -->
            <Border Grid.Column="0" Margin="0,0,10,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <!-- 顶部双标签切换栏：剪贴历史 | 常用语 -->
                    <Border Grid.Row="0" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button Grid.Column="0"
                                    Classes.accent="{Binding IsHistoryTabSelected}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8,5"
                                    CornerRadius="6"
                                    Command="{Binding SelectHistoryTabCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="📋 剪贴历史" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    <Border Background="#20888888" CornerRadius="8" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalHistoryCount}" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Classes.accent="{Binding IsPhrasesTabSelected}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8,5"
                                    CornerRadius="6"
                                    Command="{Binding SelectPhrasesTabCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Text="💬 常用语" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    <Border Background="#20888888" CornerRadius="8" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PhrasesCount}" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tab 0: 剪贴历史列表 -->
                    <ListBox x:Name="HistoryListBox"
                             Grid.Row="1"
                             IsVisible="{Binding IsHistoryTabSelected}"
                             ItemsSource="{Binding FilteredItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:MuClipItem">
                                <Border Padding="8,6" Margin="0,2" CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <!-- 第一行：类型标签 + 时间 + 字数 -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="#15000000" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding ContentTypeBadge}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding FormattedTime}" FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding CharCount, StringFormat='{}{0}字'}" FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- 第二行：内容预览截断 -->
                                            <TextBlock Text="{Binding Preview}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" />
                                        </StackPanel>

                                        <!-- 右侧操作：收藏常用语 + 快速复制 -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Button Classes="subtle"
                                                    Padding="5,4"
                                                    Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="加入常用语 / 取消常用语"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FavoriteIcon}"
                                                           Foreground="{Binding FavoriteColor}"
                                                           Opacity="{Binding FavoriteOpacity}"
                                                           FontSize="13" />
                                            </Button>

                                            <Button Classes="subtle"
                                                    Padding="6,4"
                                                    Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).CopyItemCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="直接复制到系统剪贴板"
                                                    VerticalAlignment="Center">
                                                <Panel>
                                                    <TextBlock Text="📋" FontSize="12" IsVisible="{Binding !IsCopied}" />
                                                    <TextBlock Text="✓" FontSize="12" Foreground="#10B981" FontWeight="Bold" IsVisible="{Binding IsCopied}" />
                                                </Panel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Tab 1: 常用语列表 -->
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding IsPhrasesTabSelected}">
                        <Border Grid.Row="0" Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8,5"
                                    CornerRadius="6"
                                    Command="{Binding StartNewPhraseCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="➕" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="新增常用语" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredPhrases}"
                                 SelectedItem="{Binding SelectedPhrase, Mode=TwoWay}"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:MuClipPhraseItem">
                                    <Border Padding="8,6" Margin="0,2" CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Background="#20F59E0B" CornerRadius="3" Padding="4,1">
                                                        <TextBlock Text="★ 常用语" FontSize="10" Foreground="#F59E0B" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding FormattedTime}" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CharCount, StringFormat='{}{0}字'}" FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding Preview}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Classes="subtle"
                                                        Padding="6,4"
                                                        Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).CopyPhraseCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="复制该常用语到系统剪贴板"
                                                        VerticalAlignment="Center">
                                                    <Panel>
                                                        <TextBlock Text="📋" FontSize="12" IsVisible="{Binding !IsCopied}" />
                                                        <TextBlock Text="✓" FontSize="12" Foreground="#10B981" FontWeight="Bold" IsVisible="{Binding IsCopied}" />
                                                    </Panel>
                                                </Button>

                                                <Button Classes="subtle"
                                                        Padding="5,4"
                                                        Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).DeletePhraseCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="删除该常用语"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="🗑" FontSize="11.5" Foreground="#EF4444" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- 中间：当前选中项详情展示与常用语编辑区 -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Panel>
                    <!-- 视图 A：剪贴历史详情 -->
                    <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsHistoryTabSelected}">
                        <!-- 详情头部元数据 -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="内容详情" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentFillColorTertiaryBrush}" CornerRadius="4" Padding="6,2"
                                        IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Text="{Binding SelectedItem.ContentTypeBadge}" FontSize="11"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Medium" />
                                </Border>
                                <TextBlock Text="{Binding SelectedItem.CharCount, StringFormat='{}{0} 字符'}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                           IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding SelectedItem.LineCount, StringFormat='{}{0} 行'}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                           IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Button Classes="accent" Padding="12,5"
                                        Command="{Binding CopyItemCommand}"
                                        CommandParameter="{Binding SelectedItem}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📋" FontSize="12" />
                                        <TextBlock Text="复制" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Padding="10,5"
                                        Command="{Binding ToggleFavoriteCommand}"
                                        CommandParameter="{Binding SelectedItem}"
                                        ToolTip.Tip="收藏为常用语或从常用语中移除">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding SelectedItem.FavoriteIcon}"
                                                   Foreground="{Binding SelectedItem.FavoriteColor}"
                                                   FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="常用语" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Padding="10,5"
                                        Command="{Binding BroadcastItemCommand}"
                                        CommandParameter="{Binding SelectedItem}"
                                        ToolTip.Tip="广播到其他局域网设备">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📡" FontSize="12" />
                                        <TextBlock Text="同步到设备" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Padding="8,5"
                                        Command="{Binding DeleteItemCommand}"
                                        CommandParameter="{Binding SelectedItem}"
                                        ToolTip.Tip="删除本条记录">
                                    <TextBlock Text="🗑" FontSize="12" Foreground="#EF4444" />
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- 中间文本展示区域 -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <Panel>
                                <TextBox Text="{Binding SelectedItem.Content, Mode=OneWay}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Consolas, Cascadia Code, Microsoft YaHei, monospace"
                                         FontSize="13"
                                         IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                <TextBlock Text="请在左侧选择一条剪贴记录进行查看"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNull}}" />
                            </Panel>
                        </Border>

                        <!-- 底部提示信息 -->
                        <DockPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SyncStatusText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>

                    <!-- 视图 B：常用语详情与编辑 -->
                    <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsPhrasesTabSelected}">
                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PhraseDetailTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PhraseEditorText.Length, StringFormat='{}{0} 字符'}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Padding="10,5"
                                        Command="{Binding StartNewPhraseCommand}"
                                        ToolTip.Tip="新建一条常用语">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="➕" FontSize="12" />
                                        <TextBlock Text="新建" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Classes="accent" Padding="12,5"
                                        Command="{Binding SavePhraseCommand}"
                                        ToolTip.Tip="保存当前常用语内容">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="💾" FontSize="12" />
                                        <TextBlock Text="保存" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Padding="10,5"
                                        Command="{Binding CopyPhraseCommand}"
                                        CommandParameter="{Binding SelectedPhrase}"
                                        IsVisible="{Binding HasSelectedPhrase}"
                                        ToolTip.Tip="复制当前常用语到系统剪贴板">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📋" FontSize="12" />
                                        <TextBlock Text="复制" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Padding="10,5"
                                        Command="{Binding BroadcastPhraseCommand}"
                                        CommandParameter="{Binding SelectedPhrase}"
                                        IsVisible="{Binding HasSelectedPhrase}"
                                        ToolTip.Tip="同步当前常用语到局域网设备">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="📡" FontSize="12" />
                                        <TextBlock Text="同步到设备" FontSize="12" />
                                    </StackPanel>
                                </Button>

                                <Button Padding="8,5"
                                        Command="{Binding DeletePhraseCommand}"
                                        CommandParameter="{Binding SelectedPhrase}"
                                        IsVisible="{Binding HasSelectedPhrase}"
                                        ToolTip.Tip="删除当前常用语">
                                    <TextBlock Text="🗑" FontSize="12" Foreground="#EF4444" />
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8">
                            <TextBox Text="{Binding PhraseEditorText, Mode=TwoWay}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     PlaceholderText="在此输入或编辑常用语内容，点击右上角「💾 保存」即可生效..."
                                     FontFamily="Consolas, Cascadia Code, Microsoft YaHei, monospace"
                                     FontSize="13" />
                        </Border>

                        <DockPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="{Binding SyncStatusText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Panel>
            </Border>

            <!-- 右侧：局域网同步侧边抽屉面板 -->
            <Border Grid.Column="2" Width="290" Margin="10,0,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    IsVisible="{Binding IsSyncPanelVisible}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="局域网设备与同步" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Classes="subtle" Padding="4"
                                Command="{Binding ToggleSyncPanelCommand}">
                            <TextBlock Text="✕" FontSize="11" />
                        </Button>
                    </DockPanel>

                    <!-- 设备列表滚动视图：已配对设备 + 发现附近新设备 -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <!-- 发起配对等待对方确认卡片 -->
                            <Border IsVisible="{Binding IsWaitingForPeerPinConfirmation}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="10,8">
                                <StackPanel Spacing="6">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="⏳ 等待对方输入验证" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Content="取消" Padding="6,2" FontSize="10" Command="{Binding CancelOutgoingPairCommand}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding PendingPairDeviceName, StringFormat='目标设备: {0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PendingPairPin}" FontSize="18" FontWeight="Bold" LetterSpacing="4" TextAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="请在对方设备上弹出窗口中输入上述 6 位数字以完成配对" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 收到配对请求输入卡片 -->
                            <Border IsVisible="{Binding IsIncomingPairRequestVisible}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="10,8">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="🔔" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="收到新设备配对请求" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding IncomingPairDeviceName, StringFormat='设备【{0}】请求与您配对'}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="请输入对方屏幕上显示的 6 位配对码：" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBox Text="{Binding IncomingPairInputPin, Mode=TwoWay}"
                                             MaxLength="6"
                                             FontSize="15"
                                             FontWeight="Bold"
                                             TextAlignment="Center"
                                             LetterSpacing="3"
                                             PlaceholderText="6位数字配对码"
                                             HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{Binding IncomingPairErrorMessage}"
                                               Foreground="#EF4444"
                                               FontSize="10"
                                               IsVisible="{Binding !!IncomingPairErrorMessage.Length}"
                                               TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" Margin="0,3,0,0">
                                        <Button Grid.Column="0" Content="拒绝" Command="{Binding RejectIncomingPairCommand}"
                                                Margin="0,0,3,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,4" FontSize="11" />
                                        <Button Grid.Column="1" Classes="accent" Content="确认配对" Command="{Binding ConfirmIncomingPairCommand}"
                                                Margin="3,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,4" FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 1. 已配对设备区域 -->
                            <StackPanel Spacing="6">
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="已配对设备" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                CornerRadius="8" Padding="5,1" VerticalAlignment="Center"
                                                IsVisible="{Binding HasPairedDevices}">
                                            <TextBlock Text="{Binding PairedDeviceCount}" FontSize="10" Foreground="White" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <!-- 暂无已配对设备提示 -->
                                <Border IsVisible="{Binding !HasPairedDevices}"
                                        Padding="10,8"
                                        CornerRadius="6"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <TextBlock Text="暂无已配对设备&#x0a;在下方发现列表点击「发起配对」，或在其他设备输入相同 PIN 码"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </Border>

                                <!-- 已配对设备卡片列表 -->
                                <ItemsControl ItemsSource="{Binding PairedDevices}" IsVisible="{Binding HasPairedDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:PairedDeviceInfo">
                                            <Border Padding="8,6" Margin="0,2" CornerRadius="6"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                                    <!-- 顶部：设备名与在线指示徽章 -->
                                                    <DockPanel Grid.Row="0" LastChildFill="True">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <TextBlock Text="💻" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="11.5"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="135" />
                                                            <Border Background="#20007ACC" CornerRadius="3" Padding="3,0.5"
                                                                    IsVisible="{Binding IsManual}" VerticalAlignment="Center">
                                                                <TextBlock Text="端口映射" FontSize="8.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Border Background="#10B981" CornerRadius="3" Padding="4,1" IsVisible="{Binding IsOnline}">
                                                                <TextBlock Text="在线" Foreground="White" FontSize="9" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Background="#808080" CornerRadius="3" Padding="4,1" IsVisible="{Binding !IsOnline}">
                                                                <TextBlock Text="离线" Foreground="White" FontSize="9" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- 中间：IP 端点与系统平台显示（带间隔） -->
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Endpoint}" FontSize="10"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                                                IsVisible="{Binding !!DeviceType.Length}">
                                                            <TextBlock Text="{Binding DeviceType}" FontSize="9.5"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- 底部：同步记录与操作按钮 -->
                                                    <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding LastSyncAt, StringFormat='{}同步: {0}'}" FontSize="9.5"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                                            <Button Padding="5,2" CornerRadius="3" Classes="subtle"
                                                                    Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).TestSyncWithDeviceCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="发送一条剪贴板同步测试">
                                                                <TextBlock Text="测试" FontSize="10" />
                                                            </Button>
                                                            <Button Padding="5,2" CornerRadius="3" Classes="subtle"
                                                                    Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).UnpairDeviceCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip.Tip="解除与该设备的配对">
                                                                <TextBlock Text="解除" Foreground="#EF4444" FontSize="10" />
                                                            </Button>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 2. 发现附近新设备区域 -->
                            <StackPanel Spacing="6">
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="发现附近未配对设备" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        <Border Background="#20888888" CornerRadius="8" Padding="5,1" VerticalAlignment="Center"
                                                IsVisible="{Binding HasDiscoveredPeers}">
                                            <TextBlock Text="{Binding PeerDevices.Count}" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- 右侧：自动扫描开关 + 手动扫描按钮 -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding AutoDiscoveryEnabled, Mode=TwoWay}"
                                                  Content="自动扫描" FontSize="10.5" Padding="4,0,0,0" VerticalAlignment="Center"
                                                  ToolTip.Tip="开启后周期性发送局域网信标；关闭后完全静默不发广播" />
                                        <Button Classes="subtle" Padding="6,2" CornerRadius="4"
                                                Command="{Binding ScanPeersCommand}"
                                                IsEnabled="{Binding !IsScanning}"
                                                ToolTip.Tip="立即向局域网全网卡发送一轮广播探测">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="🔄" FontSize="10" />
                                                <TextBlock Text="扫描" FontSize="10.5" IsVisible="{Binding !IsScanning}" />
                                                <TextBlock Text="扫描中..." FontSize="10.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" IsVisible="{Binding IsScanning}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>

                                <!-- 扫描状态或未发现设备 -->
                                <Border IsVisible="{Binding !HasDiscoveredPeers}"
                                        Padding="8,6"
                                        CornerRadius="4"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Panel>
                                        <TextBlock Text="正在扫描局域网广播... (UDP 42110)"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   FontSize="10" TextAlignment="Center"
                                                   IsVisible="{Binding IsScanning}" />
                                        <TextBlock Text="暂未发现新设备（自动广播中）"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   FontSize="10" TextAlignment="Center"
                                                   IsVisible="{Binding !IsScanning, FallbackValue=True}">
                                            <TextBlock.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="!IsScanning" />
                                                    <Binding Path="AutoDiscoveryEnabled" />
                                                </MultiBinding>
                                            </TextBlock.IsVisible>
                                        </TextBlock>
                                        <TextBlock Text="自动扫描已关闭，可点击右上角「🔄 扫描」手动探测"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   FontSize="10" TextAlignment="Center">
                                            <TextBlock.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="!IsScanning" />
                                                    <Binding Path="!AutoDiscoveryEnabled" />
                                                </MultiBinding>
                                            </TextBlock.IsVisible>
                                        </TextBlock>
                                    </Panel>
                                </Border>

                                <!-- 发现新设备与映射节点卡片列表 -->
                                <ItemsControl ItemsSource="{Binding PeerDevices}" IsVisible="{Binding HasDiscoveredPeers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:PeerDeviceInfo">
                                            <Border Padding="7,5" Margin="0,2" CornerRadius="4"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                <DockPanel LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button Classes="accent" Padding="7,3" CornerRadius="4"
                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).PairWithPeerCommand}"
                                                                CommandParameter="{Binding}"
                                                                VerticalAlignment="Center"
                                                                ToolTip.Tip="向对方发送配对请求">
                                                            <TextBlock Text="🔗 配对" FontSize="10" />
                                                        </Button>
                                                        <Button Classes="subtle" Padding="5,3" CornerRadius="4"
                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).RemoveManualPeerCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding IsManual}"
                                                                VerticalAlignment="Center"
                                                                ToolTip.Tip="移除该映射节点">
                                                            <TextBlock Text="删除" Foreground="#EF4444" FontSize="10" />
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DeviceName}" FontWeight="Medium" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="125" VerticalAlignment="Center" />
                                                            <Border Background="#20007ACC" CornerRadius="3" Padding="3,0.5"
                                                                    IsVisible="{Binding IsManual}" VerticalAlignment="Center">
                                                                <TextBlock Text="映射" FontSize="8.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Endpoint}" FontSize="10"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="125"
                                                                       VerticalAlignment="Center" />
                                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                    CornerRadius="3" Padding="5,1" VerticalAlignment="Center"
                                                                    IsVisible="{Binding !!DeviceType.Length}">
                                                                <TextBlock Text="{Binding DeviceType}" FontSize="9.5"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 手动单播/端口映射节点添加 -->
                    <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
                        <TextBlock Text="添加端口映射/穿透节点 (IP:端口 或 域名:端口):" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding ManualPeerInput, Mode=TwoWay}"
                                     PlaceholderText="192.168.1.88:42424 或 frp.host:55555" FontSize="11" />
                            <Button Grid.Column="1" Command="{Binding AddManualPeerCommand}" Margin="6,0,0,0" Padding="8,4">
                                <TextBlock Text="添加" FontSize="11" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 文件传输二级页面主体内容 (左右两栏卡片布局) -->
        <Grid Grid.Row="1" ColumnDefinitions="360,*" IsVisible="{Binding IsFileTransferViewActive}">
            <!-- 左侧卡片：发送文件配置 -->
            <Border Grid.Column="0" Margin="0,0,10,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <!-- 标题 -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="📤" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="发送文件到对端设备" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>

                        <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,2" />

                        <!-- 第一步：选择目标设备 -->
                        <StackPanel Spacing="6">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="1. 选择接收端设备" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Classes="subtle" Padding="4,2"
                                        Command="{Binding ScanPeersCommand}" ToolTip.Tip="刷新在线设备">
                                    <TextBlock Text="🔄 刷新设备" FontSize="10.5" />
                                </Button>
                            </DockPanel>

                            <ComboBox ItemsSource="{Binding AvailableTransferTargets}"
                                      SelectedItem="{Binding SelectedTransferTarget, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:TransferTargetDeviceItem">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center" />
                                            <Border Background="#10B981" CornerRadius="3" Padding="4,1" IsVisible="{Binding IsOnline}">
                                                <TextBlock Text="在线" Foreground="White" FontSize="9" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 手动输入 IP:Port 备用 -->
                            <TextBox Text="{Binding ManualTargetEndpoint, Mode=TwoWay}"
                                     PlaceholderText="或手动输入目标 IP:42424" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- 第二步：选择要发送的文件 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="2. 选择本地文件" FontWeight="Medium" FontSize="12" />

                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <StackPanel Spacing="8">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Padding="12,8" Command="{Binding PickSendFileCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="📁" FontSize="13" />
                                            <TextBlock Text="浏览并选择文件..." FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <!-- 已选择文件展示 -->
                                    <Border IsVisible="{Binding HasSelectedSendFile}"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4" Padding="8,6">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                            <DockPanel Grid.Row="0" LastChildFill="True">
                                                <TextBlock Text="{Binding SelectedSendFileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <Button DockPanel.Dock="Right" Classes="subtle" Padding="3,1"
                                                        Command="{Binding ClearSelectedSendFileCommand}" ToolTip.Tip="取消选择">
                                                    <TextBlock Text="✕" FontSize="10" Foreground="#EF4444" />
                                                </Button>
                                            </DockPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding SelectedSendFileSizeText, StringFormat='大小: {0}'}"
                                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Row="2" Text="{Binding SelectedSendFilePath}"
                                                       FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="310" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 第三步：启动发送按钮 -->
                        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="14,10" CornerRadius="6"
                                IsEnabled="{Binding !IsSendingFile}"
                                Command="{Binding StartSendFileCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="14" />
                                <TextBlock Text="立即高速发送" FontSize="13" FontWeight="Bold" IsVisible="{Binding !IsSendingFile}" />
                                <TextBlock Text="正在发起传输..." FontSize="13" FontWeight="Bold" IsVisible="{Binding IsSendingFile}" />
                            </StackPanel>
                        </Button>

                        <!-- 传输协议说明与特性提示 -->
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="💡 传输特性" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="• 128KB 黄金切片流式直发，零多余缓冲" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="• XChaCha20-Poly1305 分块端到端加密" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="• 自动计算 SHA-256 完整性校验" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="• 实测千兆局域网/Wi-Fi 6 吞吐率达 100MB/s+" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧卡片：传输任务列表 -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid RowDefinitions="Auto,*">
                    <!-- 列表头部 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="📊 传输任务列表" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="6,1" VerticalAlignment="Center"
                                    IsVisible="{Binding ActiveTransferCount}">
                                <TextBlock Text="{Binding ActiveTransferCount, StringFormat='{}传输中 {0}'}" FontSize="10.5" Foreground="White" FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="subtle" Padding="8,4"
                                    Command="{Binding ClearCompletedTransfersCommand}"
                                    ToolTip.Tip="清理已完成、失败或取消的历史传输任务">
                                <TextBlock Text="🗑 清理已完成" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- 任务列表滚动区域 -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Panel>
                            <!-- 空任务提示 -->
                            <Border IsVisible="{Binding !FileTransfers.Count}"
                                    Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="📂" FontSize="36" HorizontalAlignment="Center" />
                                    <TextBlock Text="暂无文件传输任务" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                                    <TextBlock Text="在左侧选择目标设备和本地文件后点击发送，&#x0a;或等待局域网内已配对设备向您传输文件。"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 任务卡片列表 -->
                            <ItemsControl ItemsSource="{Binding FileTransfers}" IsVisible="{Binding FileTransfers.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileTransferItem">
                                        <Border Margin="0,0,0,10" Padding="12,10" CornerRadius="8"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                                <!-- 第一行：方向徽章 + 文件名 + 对端设备 -->
                                                <DockPanel Grid.Row="0" LastChildFill="True">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Border Background="{Binding DirectionColor}" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding DirectionBadge}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding PeerName, StringFormat='{}对端: {0}'}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- 右侧操作按钮 -->
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Classes="subtle" Padding="6,3" CornerRadius="4"
                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).CancelTransferCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding CanCancel}"
                                                                ToolTip.Tip="取消传输">
                                                            <TextBlock Text="✕ 取消" FontSize="11" Foreground="#EF4444" />
                                                        </Button>

                                                        <Button Classes="subtle" Padding="6,3" CornerRadius="4"
                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).OpenItemFolderCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding CanOpenFolder}"
                                                                ToolTip.Tip="在资源管理器中打开所在文件夹">
                                                            <TextBlock Text="📂 打开文件夹" FontSize="11" />
                                                        </Button>

                                                        <Button Classes="accent" Padding="8,3" CornerRadius="4"
                                                                Command="{Binding #Root.((vm:ClipboardViewModel)DataContext).OpenItemFileCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding CanOpenFile}"
                                                                ToolTip.Tip="打开文件">
                                                            <TextBlock Text="打开文件" FontSize="11" />
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- 第二行：进度条 -->
                                                <ProgressBar Grid.Row="1" Minimum="0" Maximum="100"
                                                             Value="{Binding ProgressPercent}"
                                                             Height="6" CornerRadius="3" />

                                                <!-- 第三行：传输速率 + 已传输大小 + 状态文字 -->
                                                <DockPanel Grid.Row="2" LastChildFill="True">
                                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedPercent}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FormattedSpeed, StringFormat='{}⚡ {0}'}" FontSize="11"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FormattedSize}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Panel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
