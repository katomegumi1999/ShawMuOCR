<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ShawMuOCR.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- .NET 11 Runtime Async（预览），说明见根目录 ShawMuOCR.csproj -->
    <Features>runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.156.0-preview.1.26512.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>

</Project>
